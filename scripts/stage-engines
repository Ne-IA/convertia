        class _LinkedMemberDest:
            """A staged RESOURCE_TREE destination whose MEMBER is a symlink.

            A stub, for the reason `assert_not_symlink` records: `_member_path` RESOLVES, so once
            the guard sits behind it this case is unreachable - and a real symlink would cost a
            skip name on a host without the privilege, which the caged canary forbids.
            """

            name = "libreoffice"

            @staticmethod
            def is_symlink() -> bool:
                return False

            def __truediv__(self, member):
                return _MemberLink

        class _MemberLink:
            name = "soffice.bin"

            @staticmethod
            def is_symlink() -> bool:
                return True

        _record(
            "relocate_all: the symlink guard runs on the RAW member path, BEFORE `_member_path` "
            "resolves it - behind the resolution a symlinked member is indistinguishable from its "
            "target, so the guard could never fire on the RESOURCE_TREE case it exists for",
            _raises(
                lambda: relocate_all(
                    [StagedResult(EngineStaging("lo", StagingKind.RESOURCE_TREE, "libreoffice"),
                                  Path("."), _LinkedMemberDest())],
                    _LINUX, (Relocation(dest="libreoffice", member="program/soffice.bin"),),
                    write=True, runner=e2e),
                "the target is a SYMLINK",
            ),
        )
        _shared_row = EngineStaging("image-extra", StagingKind.RESOURCE_TREE, "image")
        _shared = [
            StagedResult(EngineStaging("image", StagingKind.RESOURCE_TREE, "image"),
                         Path("."), staged_file),
            StagedResult(_shared_row, None, None),  # a SECOND engine on the same dest, absent
        ]
        _shared_runner = _RelocationRunner(readback="$ORIGIN")
        relocate_all(_shared, _LINUX, (Relocation(dest="image"),), write=True,
                     runner=_shared_runner)
        _record(
            "relocate_all: several rows may share one RESOURCE_TREE dest (§3.3.1 maps the whole "
            "image stack onto resources/image/), and they come from DIFFERENT engines - an absent "
            "one must not hide a destination another engine DID stage",
            any(call[:2] == ["patchelf", "--set-rpath"] for call in _shared_runner.calls),
        )
        _record(
            "relocate_all: ...and the binder agrees with it - a dest ANY row stages is bound, so "
            "the two do not disagree about what a dest is",
            assert_relocations_bound((_shared[0].row, _shared_row), (Relocation(dest="image"),))
            is None,
        )
        _swapped = [_shared[1], _shared[0]]  # the ABSENT row first
        _swapped_runner = _RelocationRunner(readback="$ORIGIN")
        relocate_all(_swapped, _LINUX, (Relocation(dest="image"),), write=True,
                     runner=_swapped_runner)
        _record(
            "relocate_all: ...in BOTH orders - `results` follows declaration order, and §3.3.1 maps "
            "several P5 boxes onto resources/image/, so absent-FIRST is as reachable as "
            "absent-last; a first-wins dict would re-open the defect the last-wins one had",
            any(call[:2] == ["patchelf", "--set-rpath"] for call in _swapped_runner.calls),
        )
        _record(
            "relocate_all: a relocation naming a MEMBER the staging step did not produce is "
            "refused with a diagnostic - without the guard it falls into relocate_one's open() and "
            "surfaces as a bare filesystem error that names neither the declaration nor the tree",
            _raises(
                lambda: relocate_all(
                    [StagedResult(EngineStaging("lo", StagingKind.RESOURCE_TREE, "libreoffice"),
                                  Path("."), base / "no-such-tree")],
                    _LINUX, (Relocation(dest="libreoffice", member="program/soffice.bin"),),
                    write=True, runner=e2e),
                "the staging step did not produce",
            ),
        )
        absent = [StagedResult(rows[0], None, None)]
        _record(
            "relocate_all: the count is REPORTED - in a box whose thesis is that a rewrite doing "
            "nothing must be visible, a run that rewrote zero files must not read like one that "
            "rewrote three",
            "relocated 1 staged file(s)" in _printed(
                lambda: relocate_all(results, _LINUX, (Relocation(dest="ffmpeg"),), write=True,
                                     runner=_RelocationRunner(readback="$ORIGIN"))
            ),
        )
        # A FIXED, distinctive stamp rather than "whatever the mtime was": two relocations inside
        # one Windows clock tick (~15.6 ms) carry the SAME mtime, so a before/after comparison
        # passes by coincidence and the leg is flaky - which is how the mutation battery first
        # read this guard as unpinned. Stamped, the assertion is deterministic on every host.
        _stamp = 1_000_000_000
        os.utime(staged_file, (_stamp, _stamp))
        _stat_before = staged_file.stat()
        relocate_all(results, _LINUX, (Relocation(dest="ffmpeg"),), write=True,
                     runner=_RelocationRunner(readback="$ORIGIN"))
        _record(
            "relocate_all: the published file's MODE and mtime survive the rewrite round trip - "
            "relocation is a new publish path over a file whose dropped +x the module docstring "
            "calls load-bearing (it surfaces as a misleading startup 'integrity failed'). The "
            "mtime is what makes this observable on a host with no exec bit to lose: `copy2` seeds "
            "the sibling, the TOOL then touches it, and only the closing `copystat` puts the "
            "original stamp back",
            staged_file.stat().st_mode == _stat_before.st_mode
            and int(staged_file.stat().st_mtime) == _stamp,
        )
        _bad_check = _RELOCATORS[_LINUX]
        try:
            _RELOCATORS[_LINUX] = lambda pth, r: [["patchelf", str(pth), "--set-rpath", "$ORIGIN"]]
            _record(
                "relocate_all: --CHECK reaches the argv contract too - it is byte-free, so a check "
                "pass that skipped it would validate less than the run for a reason that has "
                "nothing to do with the bytes",
                _raises(lambda: relocate_all(results, _LINUX, (Relocation(dest="ffmpeg"),),
                                             write=False, runner=e2e),
                        "does not end in the target path"),
            )
        finally:
            _RELOCATORS[_LINUX] = _bad_check
        _record(
            "relocate_all: an engine the cache does not carry is nothing to do, not a violation",
            relocate_all(absent, _LINUX, (Relocation(dest="ffmpeg"),), write=True, runner=e2e)
            == [],
        )
        _record(
            "relocate_all: an unrelocatable target is refused BEFORE any path is resolved",
            _raises(lambda: relocate_all(results, "riscv64-unknown-linux-gnu", (), write=False,
                                         runner=e2e),
                    "no declared load-path relocation"),
        )

    # The WIRING, not the mechanism. Every leg above drives `relocate_all` / `relocate_one`
    # DIRECTLY, and a mutation battery showed that deleting the tail call from either `stage_all`
    # branch survived all of them - the fallback would simply stop happening while the suite stayed
    # green. It is the same unpinned-seam shape the P4.29.1 review measured one box earlier, so
    # both branches get a leg that drives the real entry point and observes the tool it must spawn.
    # `RELOCATIONS` is patched the way `STAGED_ENGINES` already is, restored in `finally`.
    for _label, _triple, _fixture, _rows, _needle in (
        ("PER-ARCH", _LINUX, _fixture_tree, (EngineStaging("ffmpeg", StagingKind.SIDECAR, "ffmpeg"),),
         ["patchelf", "--set-rpath"]),
        ("UNIVERSAL", UNIVERSAL_TRIPLE, _universal_fixture, None, ["install_name_tool", "-change"]),
    ):
        with tempfile.TemporaryDirectory() as tmp:
            _root, _cache = _fixture(Path(tmp).resolve())
            # ONE readback string serving BOTH wiring legs: the Linux tail looks for `$ORIGIN`,
            # the macOS one for the `-change` target its row declared.
            _wired = _RelocationRunner(readback="$ORIGIN\n@loader_path/libmp3lame.0.dylib\n")
            _saved = RELOCATIONS
            try:
                globals()["RELOCATIONS"] = (
                    Relocation(dest="ffmpeg",
                               references=(("/opt/build/lib/libmp3lame.0.dylib",
                                            "libmp3lame.0.dylib"),)),
                )
                stage_all(_root, _cache, _triple, _rows or _UNIVERSAL_ROWS, runner=_wired)
            finally:
                globals()["RELOCATIONS"] = _saved
            _record(
                f"wiring: stage_all's {_label} branch runs the relocation tail - deleting the call "
                "survives every leg that drives relocate_all directly",
                any(call[: len(_needle)] == _needle for call in _wired.calls),
            )

    # `stage_all` gained THREE new lines this box; the two above pinned two of them, and a round-3
    # mutation showed the third - the binder call - could be deleted with all 169 legs still green,
    # letting a typo'd `dest` fall through `relocate_all`'s absent-row `continue` and silently skip
    # the rewrite. Same for the runner default: every other leg passes `runner=` explicitly, so the
    # one production path that reaches `run_tool` for the tail was untested. Both seams, both
    # pinned. [Build-Session-Entscheidung: P4.30]
    with tempfile.TemporaryDirectory() as tmp:
        _seam_root, _seam_cache = _fixture_tree(Path(tmp).resolve())
        _seam_rows = (EngineStaging("ffmpeg", StagingKind.SIDECAR, "ffmpeg"),)
        _saved_rel, _saved_tool = RELOCATIONS, run_tool
        try:
            globals()["RELOCATIONS"] = (Relocation(dest="ffmpg"),)  # a typo'd dest, on purpose
            _record(
                "wiring: stage_all runs the BINDER - a relocation naming no staged row is refused "
                "there, not silently skipped later by relocate_all's absent-row arm",
                _raises(lambda: stage_all(_seam_root, _seam_cache, _LINUX, _seam_rows,
                                          runner=_RelocationRunner()),
                        "name no staged row"),
            )
            globals()["RELOCATIONS"] = (Relocation(dest="ffmpeg"),)
            _defaulted = _RelocationRunner(readback="$ORIGIN")
            globals()["run_tool"] = _defaulted
            stage_all(_seam_root, _seam_cache, _LINUX, _seam_rows)
            _record(
                "wiring: stage_all DEFAULTS the runner for the relocation tail - the one production "
                "path that reaches `run_tool` passes no runner of its own",
                any(call[:2] == ["patchelf", "--set-rpath"] for call in _defaulted.calls),
            )
        finally:
            globals()["RELOCATIONS"], globals()["run_tool"] = _saved_rel, _saved_tool

    failed = [n for n, ok in _results if not ok]
    print(f"\n[stage-engines --selftest] {len(_results) - len(failed)}/{len(_results)} passed")
    if failed:
        for n in failed:
            fail(f"FAILED: {n}")
        return 1
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="stage-engines", description=__doc__.splitlines()[0])
    ap.add_argument("--root", default=None, help="repo root to stage into (default: the repo; a fixture tree in the self-test)")
    ap.add_argument("--cache-root", default=None, help=f"restored engine-asset cache (default: <root>/{DEFAULT_CACHE_REL})")
    ap.add_argument("--target", default=None, help="target triple to stage for (default: this host's)")
    ap.add_argument("--check", action="store_true", help="resolve + validate only; write nothing")
    ap.add_argument("--dry-run", action="store_true", help="alias of --check")
    ap.add_argument("-v", "--verbose", action="store_true", help="list every staged row")
    ap.add_argument("--selftest", action="store_true", help="run the fixture-driven regression suite")
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    root = Path(args.root).resolve() if args.root else ROOT
    cache_root = Path(args.cache_root).resolve() if args.cache_root else root / DEFAULT_CACHE_REL
    write = not (args.check or args.dry_run)
    try:
        triple = resolve_target(args.target)
        # With zero declared rows there is nothing to resolve AGAINST the cache, so demanding a
        # restored cache root would be a spurious failure on a P1-P4 tree that has none. Every
        # per-row check lives in stage_all and arms itself with the first P5-P7 row.
        conf_path = root / TAURI_CONF_REL
        if not STAGED_ENGINES:
            # The ROW side is empty; the CONFIG side is not necessarily. An `externalBin` entry or
            # a `resources/<subdir>/` key that no row stages names bytes this script will never
            # produce - and while `tauri-build` does fail on the missing path, it fails one step
            # later, in a compile whose error is about a file rather than about the two
            # declarations having drifted apart. Checked here too, so the binder is live from
            # P4.31 rather than arming only with the first P5 row.
            # [Build-Session-Entscheidung: P4.31]
            assert_rows_bound_to_bundle((), conf_path)
            report([], triple, write=write, verbose=args.verbose)
            return 0
        results = stage_all(
            root,
            cache_root,
            triple,
            STAGED_ENGINES,
            write=write,
            lock_path=root / LOCK_REL,
            conf_path=conf_path,
        )
        # On the universal run the cache holds no `-universal-apple-darwin` entry - it is keyed
        # per real triple - so scanning for that suffix would always report nothing, silencing the
        # "a build input, or a MISSING STAGING ROW" signal on exactly the leg that reads two.
        # In PRODUCTION this is not reached while `STAGED_ENGINES` is empty - `main` returns
        # above on the no-rows path - but the suite reaches it by patching the row set, which is
        # how the per-triple form is already covered. A first attempt recorded it as untestable;
        # the dual review disproved that by writing the leg, so the leg is below.
        scanned = UNIVERSAL_SLICES if triple == UNIVERSAL_TRIPLE else (triple,)
        unclaimed = sorted(
            {
                name
                for slice_triple in scanned
                for name in unclaimed_cache_entries(cache_root, STAGED_ENGINES, slice_triple)
            }
        )
    except StagingError as e:
        fail(str(e))
        return 2 if e.structural else 1
    except OSError as e:
        # A permission denial, a full disk, a dangling symlink in a real engine tree: a clean
        # diagnosable exit, never a traceback the CI log buries.
        fail(f"filesystem error while staging for {args.target or 'this host'}: {e}")
        return 1
    report(results, triple, write=write, verbose=args.verbose, unclaimed=unclaimed)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
