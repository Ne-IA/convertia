            _record(
                "relocate_one: a builder whose argv does NOT end in the target path is refused - "
                "the substitution rewrites the LAST token, so any other shape would leave the tool "
                "pointing at the PUBLISHED file and lose the atomic publish",
                _raises(lambda: relocate_one(_target("argv.so"), Relocation(dest="x"), _LINUX,
                                             runner=_RelocationRunner(readback="$ORIGIN")),
                        "does not end in the target path"),
