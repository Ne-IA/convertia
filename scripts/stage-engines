        class _LinkTarget:
            """A stand-in that only answers `is_symlink()` - the guard runs before any read, so a
            leg needs no OS link privilege to drive it, and therefore records no skip on a host
            that lacks one."""

            name = "libmp3lame.0.dylib"

            @staticmethod
            def is_symlink() -> bool:
                return True

        _record(
            "relocate_one: a SYMLINK target is refused rather than silently flattened by the "
            "copy-rewrite-replace - which of the two meanings a rewrite has there is the declaring "
            "box's call",
            _raises(lambda: relocate_one(_LinkTarget, _lib, _MAC,
                                         runner=_RelocationRunner(readback="@loader_path/x")),
                    "the target is a SYMLINK"),
