            "every other leg drives one half alone, which left the multi-tool loop unpinned",
            [c[0] for c in _both_runner.calls] == ["install_name_tool", "otool", "otool"]
            and {c[1] for c in _both_runner.calls if c[0] == "otool"} == {"-D", "-L"},
        )
        _record(
