#!/usr/bin/env python3
"""setup-dev - one-step developer bootstrap (run after clone).

Does the whole local setup the gate plane needs:
  0. on Windows, refuse a `python3` that resolves to the Microsoft Store Python (or to nothing),
  1. install + checksum-verify the pinned gate tools  -> .gate-tools/bin
     (python3 -P scripts/install-gate-tools)
  2. install the lefthook git-hook plane (every hook lefthook.yml declares)
  3. REPAIR lefthook's generated hooks so they work on ANY repo path, then
  4. verify each generated hook parses under POSIX sh, and
  5. on Windows, pin git's ssh-signing to the agent-reachable OpenSSH ssh-keygen.

WHY step 3: lefthook embeds an UNQUOTED absolute path to its own binary in every
generated hook. On a repo path containing spaces or parentheses (e.g.
".../ne-ia (platform)/...") that unquoted path is a POSIX-sh SYNTAX ERROR - it
breaks the whole hook, and git aborts the commit or push it guards. This script quotes
that path after `lefthook install`. On a clean path the quoting is a harmless
no-op, so setup-dev is safe + identical everywhere.

THE ONE INSTALLER: lefthook.yml sets `no_auto_install: true` (G54b leg (6)). Without it every
lefthook run re-installed the hooks once the parsed config differed from the last install's and
wrote the unquoted path back over step 3's repair, and the next commit aborted. No lefthook run
installs a hook, so a hook that lefthook.yml newly declares is installed only here: re-run this
script when G54 names a declared hook that is missing, never a bare `lefthook install`.

WHY step 0: every lefthook command runs `python3 -P scripts/...`. On Windows `python3` can resolve
to the Microsoft Store Python's App Execution Alias (%LOCALAPPDATA%\\Microsoft\\WindowsApps). A process
started through it carries the RedirectionGuard audit mitigation (ProcessRedirectionTrustPolicy
flags 0x2) and every process below it inherits it; under it the Vite resolver (rolldown's
oxc_resolver) can miss the first bare-package resolution through pnpm's node_modules junctions, and
a vitest suite of the TypeScript gate then fails to resolve an import - an intermittent red hook
with no code cause. The preflight refuses that interpreter before anything is installed and names
the fix. Non-Windows: a harmless no-op.

WHY step 5: with `gpg.format = ssh` + `commit.gpgsign`, git signs each commit by
running `ssh-keygen -Y sign`. On Windows, Git-for-Windows may resolve its BUNDLED
MSYS2 ssh-keygen, which CANNOT reach the Windows OpenSSH agent (a named pipe) - it
then falls back to the passphrase-protected key FILE and, with no TTY, HANGS forever.
A non-interactive `git commit -S` (every Build-Loop commit) would wedge silently. We
pin `gpg.ssh.program` to the native Windows OpenSSH ssh-keygen, which talks to the
agent's named pipe and signs without a prompt. Non-Windows: a harmless no-op.

Idempotent. stdlib-only (Python 3.12+ - `scripts/stage-engines` uses `Path.is_junction()`, 3.12; CI pins 3.12). Run:  python3 -P scripts/setup-dev
Exit: 0 = ready; non-zero = a step failed (with a clear message).
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path, PureWindowsPath
for _stream in (sys.stdout, sys.stderr):          # the console's codepage is not this script's concern (G9 invariant i)
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8", errors="replace")

REPO = Path(__file__).resolve().parent.parent
IS_WIN = sys.platform.startswith("win")
LEFTHOOK = REPO / ".gate-tools" / "bin" / ("lefthook.exe" if IS_WIN else "lefthook")


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    print(f"  $ {' '.join(str(c) for c in cmd)}")
    return subprocess.run(cmd, **kw)


def step(msg: str) -> None:
    print(f"\n==> {msg}")


def die(msg: str) -> None:
    print(f"[setup-dev] FAILED: {msg}", file=sys.stderr)
    raise SystemExit(1)


# [Build-Session-Entscheidung: P0.2.3] the Store Python is recognised by a `WindowsApps` path COMPONENT: its App
# Execution Aliases (%LOCALAPPDATA%\Microsoft\WindowsApps\python3.exe and the per-package alias directory in that
# folder) and its package install (%ProgramFiles%\WindowsApps\PythonSoftwareFoundation.Python.3.N_...) all sit under
# one. A component match, not a substring: a directory merely named like it (`MyWindowsApps`) is not the Store.
_STORE_DIR = "windowsapps"
_PYTHON3_INSTALL = ("install CPython from python.org matching the CI pin (3.12), give it a python3.exe (for example a "
                    "copy of its python.exe in its install directory) and put that directory")


def python3_refusal(resolved: str | None) -> str | None:
    """(pure) Why the `python3` the hooks resolve (a `shutil.which` hit, or None) cannot run the gate plane on
    Windows - or None when it can. Parsed as a Windows path on every OS, so the self-test runs anywhere."""
    if resolved is None:
        return ("no python3 on PATH - every lefthook command runs `python3 -P scripts/...`. "
                f"Fix: {_PYTHON3_INSTALL} on PATH")
    if any(part.lower() == _STORE_DIR for part in PureWindowsPath(resolved).parts):
        return (f"python3 resolves to the Microsoft Store Python ({resolved}). A process started through it carries "
                "the RedirectionGuard audit mitigation and every process below it inherits it; under it the Vite "
                "resolver can miss the first bare-package resolution through pnpm's node_modules junctions, and a "
                "vitest suite of the TypeScript gate then fails to resolve an import (an intermittent red hook). "
                f"Fix: {_PYTHON3_INSTALL} "
                r"ahead of %LOCALAPPDATA%\Microsoft\WindowsApps on PATH, or turn off the python.exe and python3.exe "
                "App Execution Aliases (Settings > Apps > Advanced app settings > App execution aliases) so that "
                "python3.exe is found")
    return None


def python3_preflight() -> None:
    step("0/5  preflight: python3 is not the Microsoft Store Python (Windows)")
    if not IS_WIN:
        print("  non-Windows - no Store App Execution Alias; nothing to check")
        return
    resolved = shutil.which("python3")
    reason = python3_refusal(resolved)
    if reason is not None:
        die(reason)
    print(f"  python3 -> {resolved}")


def install_gate_tools() -> None:
    step("1/5  install + verify pinned gate tools")
    p = run([sys.executable, "-P", str(REPO / "scripts" / "install-gate-tools")])
    if p.returncode != 0:
        die("install-gate-tools failed (see output above)")


def lefthook_install() -> None:
    step("2/5  install the lefthook git-hook plane")
    if not LEFTHOOK.is_file():
        die(f"lefthook not found at {LEFTHOOK} - did step 1 install it?")
    p = run([str(LEFTHOOK), "install"], cwd=str(REPO))
    if p.returncode != 0:
        die("lefthook install failed")


def effective_hooks_dir() -> Path:
    p = subprocess.run(["git", "rev-parse", "--git-path", "hooks"],
                       cwd=str(REPO), capture_output=True, text=True, encoding="utf-8", errors="replace")
    if p.returncode != 0:
        die("git rev-parse --git-path hooks failed (not a git repo?)")
    d = Path(p.stdout.strip())
    if not d.is_absolute():
        d = (REPO / d).resolve()
    return d


def repair_hooks(hooks_dir: Path) -> None:
    step("3/5  repair generated hooks (quote lefthook's embedded path)")
    embedded = LEFTHOOK.resolve().as_posix()        # the form lefthook writes (forward slashes)
    patched_any = False
    for hook in sorted(hooks_dir.glob("*")):
        if hook.suffix == ".sample" or not hook.is_file():
            continue
        text = hook.read_text(encoding="utf-8", errors="replace")
        if embedded not in text:
            continue
        # Idempotent + targeted: quote the two unquoted occurrences lefthook emits
        # (the `elif <p> -h` probe and the `    <p> "$@"` invocation). On a re-run
        # those patterns are already quoted, so the replaces are no-ops and the
        # `new != text` guard below skips the write - re-entering this body is
        # harmless (the bare path is still a substring of the quoted form).
        new = (text
               .replace(f"elif {embedded} -h", f'elif "{embedded}" -h')
               .replace(f"\n    {embedded} ", f'\n    "{embedded}" '))
        if new != text:
            hook.write_text(new, encoding="utf-8")
            print(f"  quoted embedded path in {hook.name}")
            patched_any = True
    if not patched_any:
        print("  nothing to quote (clean path or already repaired) - ok")


def verify_parse(hooks_dir: Path) -> None:
    step("4/5  verify each generated hook parses under sh")
    # If no sh is on PATH we skip the parse check INTENTIONALLY (not an oversight):
    # git invokes the hook with its own bundled sh at runtime, and on a clean path
    # the generated hooks are valid regardless.
    sh = subprocess.run(["sh", "-c", "exit 0"], capture_output=True)
    if sh.returncode != 0:
        print("  sh not available - skipping parse check (git uses its own sh at runtime)")
        return
    broken = []
    for hook in sorted(hooks_dir.glob("*")):
        if hook.suffix == ".sample" or not hook.is_file():
            continue
        if subprocess.run(["sh", "-n", str(hook)], capture_output=True).returncode != 0:
            broken.append(hook.name)
    if broken:
        die(f"hook(s) still do not parse after repair: {', '.join(broken)}")
    print("  all generated hooks parse OK")


def configure_ssh_signing() -> None:
    step("5/5  pin git ssh-signing to the agent-reachable ssh-keygen (Windows)")
    if not IS_WIN:
        print("  non-Windows - the platform ssh-keygen reaches the agent natively; nothing to pin")
        return
    keygen = Path(os.environ.get("WINDIR", r"C:\Windows")) / "System32" / "OpenSSH" / "ssh-keygen.exe"
    if not keygen.is_file():
        print(f"  Windows OpenSSH ssh-keygen not found at {keygen} - skipping (no native signer to pin)")
        return
    p = run(["git", "config", "--local", "gpg.ssh.program", keygen.as_posix()], cwd=str(REPO))
    if p.returncode != 0:
        die("git config gpg.ssh.program failed (see output above)")
    print(f"  gpg.ssh.program -> {keygen.as_posix()}")


def main() -> int:
    print("setup-dev - ConvertIA developer bootstrap")
    python3_preflight()
    install_gate_tools()
    lefthook_install()
    hd = effective_hooks_dir()
    repair_hooks(hd)
    verify_parse(hd)
    configure_ssh_signing()
    print("\n[setup-dev] ready - the gate plane is installed and the hooks parse. "
          "Commits/pushes now run the L1/L2/L3 gates.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
