#!/usr/bin/env python3
"""check-js-supply-chain - G18c / G18d (+ G36b slot) JS/WebView supply-chain gate (P0.3.8).

The WebView is the ENTIRE T2 attack surface, so its supply chain matches the Rust-side discipline. This
freezes the JS supply-chain posture (stdlib only):

  * G18c REGISTRY PIN - `.npmrc` pins the default registry to the single allowed origin AND declares no
    scoped/per-registry override to any other origin (`@scope:registry=` / `//host/:registry`); once
    `pnpm-lock.yaml` exists (P1) EVERY resolution is checked - by SHAPE: a `resolution` may only be the
    registry form pnpm's own dumper writes (`{integrity: sha...-...}`), so a tarball URL,
    a git repo (clone-and-BUILD = code-exec from an arbitrary host), a directory or a `file:` is refused
    without the scan having to read the URL; a fail-closed token scan over the escape-decoded text then
    rejects any foreign host and any non-registry SCHEME (git+/git:/ssh:/file:/protocol-relative //)
    anywhere else (the G18c block below);
  * G18d LIFECYCLE LOCKDOWN - `.npmrc` keeps the install posture locked (`enable-pre-post-scripts` and
    `unsafe-perm` each pinned to exactly `false`, since pnpm reads an absent key and any other value as ON,
    and neither re-set in `pnpm-workspace.yaml`, whose keys pnpm reads over `.npmrc`) and refuses any
    committed frozen-lockfile setting - an `.npmrc` `frozen-lockfile` key at any value or a
    `frozenLockfile` / `frozenLockfileIfExists` token in `pnpm-workspace.yaml` - because CI's pin is G18a's
    `--frozen-lockfile` flag-scan and a committed setting also freezes Dependabot's
    `pnpm install --lockfile-only` resolve. In `pnpm-workspace.yaml` every setting this guard refuses is
    a token search at any value, and a `${` anywhere is refused, since pnpm substitutes the environment
    into that file's keys (the pnpm-workspace.yaml block below). `.npmrc` is read the way pnpm's own ini
    reader reads it, it may carry only the keys this guard evaluates (_NPMRC_KEYS: a key such as
    `userconfig` makes pnpm load a further config file), and the spellings a static read cannot settle
    (a `[section]` header, an array key, an environment-substituted key, a key that decodes to a
    non-string) are refused fail-closed (the
    `.npmrc` reader block below); once a pnpm manifest exists (P1) the build-script allowlist
    (`onlyBuiltDependencies` / pnpm-11 `allowBuilds`) stays <= the frozen count, FAIL-CLOSED on a
    present-but-unparseable allowlist, and a committed manifest WITHOUT a committed lockfile FAILS
    (mirrors the Rust check-supply-chain workspace-state - never a silent skip on a real workspace);
  * G36b (RELEASE-TIER slot) - the frontend GPL/AGPL hard-fail runs over the cdxgen SBOM (G35), NOT over
    pnpm-lock.yaml (the lock carries no license data); it is release-tier per build-gates G36b and stays
    target-absent here until G35 lands;
  * §0.8 JS PINNED-FLOOR (P1.60) - each PINNED_FLOORS_JS dep (@tauri-apps/cli, @tauri-apps/api,
    @tauri-apps/plugin-log, zustand, fast-check, vitest-axe) must be a DIRECT dep in pnpm-lock.yaml
    resolved at >= its floor - the JS mirror of the Rust check-supply-chain pinned-floor leg.

Scope note: once pnpm-lock.yaml exists (P1.2.2) the lockfile resolution scan + the onlyBuiltDependencies
count + the §0.8 floor are LIVE; the `.npmrc` posture is enforced regardless. The covered surface is the
committed-config install/source-substitution surface of the PINNED pnpm (10.13.1, §0.8) - a pnpm
major-version bump is itself a pinned-version change (security-concept §0 pin-and-verify) that triggers
a re-audit of this gate against the new pnpm config surface. `.npmrc` is L(-1)
(scripts/l-neg1-files.toml, G71) - relaxing the pin / lockdown is an owner-ack + Dual-Review change.

Exit: 0 = posture OK (+ live checks pass or target-absent); 1 = a relaxation / a foreign-or-non-registry
       resolution / a scoped-registry override / a grown-or-unparseable allowlist / a lock-missing
       manifest / a committed frozen-lockfile setting / a lifecycle pin re-set in pnpm-workspace.yaml /
       a refused setting, a source-redirect prefix or a `${` in pnpm-workspace.yaml /
       an `.npmrc` key this guard does not evaluate or a spelling it cannot settle;
       2 = a config file is missing or unparseable.
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path
for _stream in (sys.stdout, sys.stderr):          # the console's codepage is not this script's concern (G9 invariant i)
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8", errors="replace")

ROOT = Path(__file__).resolve().parents[1]
NPMRC = ROOT / ".npmrc"
PNPM_LOCK = ROOT / "pnpm-lock.yaml"
PNPM_WORKSPACE = ROOT / "pnpm-workspace.yaml"
PACKAGE_JSON = ROOT / "package.json"
# pnpm's `pnpmfile` setting DEFAULTS to ['.pnpmfile.mjs']; pnpm reads .pnpmfile.mjs (ESM) OR
# .pnpmfile.cjs (CommonJS) - forbid all four names (the .mjs default is the more-preferred one)
PNPMFILE_CANDIDATES = (ROOT / ".pnpmfile.mjs", ROOT / ".pnpmfile.cjs",
                       ROOT / "pnpmfile.mjs", ROOT / "pnpmfile.cjs")
PATCHES_DIR = ROOT / "patches"
_SKIP_DIRS = {"node_modules", ".git", ".gate-tools", "target", "dist"}
# override/resolution values that REDIRECT a dependency's source location (vs a plain version pin or the
# accepted npm:-alias name-trust residual / a legit workspace: monorepo link)
_REDIRECT_SPEC = re.compile(r"(?i)^\s*(file:|link:|portal:|git\+|git:|ssh:|https?://)")
_INSTALL_HOOKS = ("preinstall", "install", "postinstall", "prepare", "preprepare", "postprepare",
                  "prepublish", "dependencies")

ALLOWED_REGISTRY = "https://registry.npmjs.org/"
ALLOWED_HOST = "registry.npmjs.org"
# A committed frozen-lockfile setting is refused at ANY value (G18a). pnpm 10.13.1 freezes a
# `--lockfile-only` resolve (Dependabot's) on exactly two settings, `frozenLockfile` and
# `frozenLockfileIfExists` (its install step reads
# `opts.frozenLockfile || opts.frozenLockfileIfExists && existsNonEmptyWantedLockfile`, and the `ci` default
# feeds `frozenLockfileIfExists` only when the install is not lockfile-only; `preferFrozenLockfile` does not
# freeze). In .npmrc it is every key the reader block below maps to `frozen-lockfile`, the one key pnpm
# 10.13.1 honours there, matched with any case and an optional `-` / `_` (`frozenLockfile`,
# `FROZEN-LOCKFILE` and `frozen_lockfile` do not freeze pnpm 10.13.1, measured, and are refused
# fail-closed); every other .npmrc spelling, `frozen-lockfile-if-exists` included (not read there,
# measured), is refused as a key outside _NPMRC_KEYS. In pnpm-workspace.yaml, where pnpm copies every key
# into its settings, it is a token search for either setting in any case, with an optional `-` / `_` after
# `frozen` (a separator after `lockfile` ends the shorter token, so `frozen-lockfile-if-exists` matches too),
# over the raw and the escape-decoded text with nothing excised (workspace_frozen_lockfile_problems);
# `preferFrozenLockfile` and a longer key do not match. A setting the refusal cannot see still fails the
# Dependabot npm job, which the watch-health triage reads (roles-and-escalation §5a).
_FROZEN_KEY_RE = re.compile(r"frozen[-_]?lockfile", re.IGNORECASE)
_FROZEN_TOKEN_RE = re.compile(r"(?<![A-Za-z])frozen[-_]?lockfile(?:ifexists)?(?![A-Za-z])", re.IGNORECASE)
# The two lifecycle pins must each be present and exactly `false` (G18d): pnpm 10.13.1 reads an absent key
# as ON (its defaults: `enable-pre-post-scripts` true, `unsafe-perm` true unless running as root) and every
# value but `false` as ON too - a bare key, an empty value, `FALSE`, `yes` (measured: the root project's
# `pre<script>` ran under each). The pins live in .npmrc only: pnpm copies every pnpm-workspace.yaml key
# over the .npmrc value (measured: `enablePrePostScripts: true` there ran the `pre<script>` with the .npmrc
# pin at `false`, and `unsafePerm: true` read as true), so a token naming either pin in pnpm-workspace.yaml
# is refused at any value, found as the frozen token is (workspace_lifecycle_problems).
_LIFECYCLE_PINS = {
    "enable-pre-post-scripts": "npm pre/post script hooks must stay OFF (a dep could run arbitrary code on install)",
    "unsafe-perm": "must stay off",
}
_LIFECYCLE_TOKEN_RE = re.compile(r"(?<![A-Za-z])(?:enable[-_]?pre[-_]?post[-_]?scripts|unsafe[-_]?perm)(?![A-Za-z])",
                                 re.IGNORECASE)
# The pnpm-workspace.yaml block. pnpm 10.13.1 reads every key of that file as a setting, in any YAML key form
# (`pnpm config get` read `configDependencies`, `onlyBuiltDependenciesFile`, `patchedDependencies` and
# `dangerouslyAllowAllBuilds` from the block, quoted, flow and explicit forms alike, measured), so a `^key:` line
# read cannot see them. Every setting this guard refuses there is therefore a token search at any value, found
# as the frozen token is (any case, an optional `-` / `_` between words, raw and escape-decoded, nothing
# excised): the frozen and lifecycle tokens above, the four settings just named (install-time code, patches and
# the build-script allowlist; `dangerouslyAllowAllBuilds` ran a dependency's postinstall in the quoted, flow,
# explicit and hex-escaped key forms, and under `false` plus a more-indented continuation line, a plain scalar
# pnpm reads as the truthy `false on`, measured), and `registries` (a `registries` map re-pointed resolution
# over the .npmrc pin in the block, flow and quoted form, measured - the registry pin lives in .npmrc only, as
# the lifecycle pins do). A source-redirect spec prefix (_REDIRECT_SPEC's set) is refused anywhere in the file:
# a flow-form `overrides` and a hex-escaped `link:` value in a block-form one each rewrote a dependency to a
# local link (measured), and the `^overrides:` block reader below read neither. pnpm also substitutes the
# environment into every top-level key and string value there (`${NAME}` / `${NAME-fallback}`, a global
# replace), so a key composed across `${` hides every token: `${UNSET-frozen}Lockfile`, its hex-escaped
# `\x24{` twin and `${UNSET-regis}tries` each took effect (measured). A static read cannot settle that, so a
# `${` anywhere in the file is refused, raw or escape-decoded (workspace_env_problems).
_PATCHED_DEPS_TOKEN_RE = re.compile(r"(?<![A-Za-z])patched[-_]?dependencies(?![A-Za-z])", re.IGNORECASE)
_CONFIG_DEPS_TOKEN_RE = re.compile(r"(?<![A-Za-z])config[-_]?dependencies(?![A-Za-z])", re.IGNORECASE)
_ONLYBUILT_FILE_TOKEN_RE = re.compile(r"(?<![A-Za-z])only[-_]?built[-_]?dependencies[-_]?file(?![A-Za-z])",
                                      re.IGNORECASE)
_ALLOW_ALL_BUILDS_TOKEN_RE = re.compile(r"(?<![A-Za-z])dangerously[-_]?allow[-_]?all[-_]?builds(?![A-Za-z])",
                                        re.IGNORECASE)
_REGISTRIES_TOKEN_RE = re.compile(r"(?<![A-Za-z])registries(?![A-Za-z])", re.IGNORECASE)
_REDIRECT_TOKEN_RE = re.compile(r"(?<![A-Za-z0-9])(?:(?:file|link|portal|git|ssh|https?):|git\+)", re.IGNORECASE)
_ENV_EXPR_RE = re.compile(r"\$\{")
# The committed .npmrc carries only the keys this guard evaluates: `registry`, a scoped `<scope>:registry`
# key (the override check below) and the two lifecycle pins. Any other key is refused fail-closed, because a
# key can change what pnpm reads beyond this one file: `userconfig`, `globalconfig`, `prefix` (its
# `etc/npmrc`) and `workspace-prefix` (its `.npmrc`) each load a further config file (measured through pnpm
# 10.13.1: a `frozen-lockfile=true` there froze the resolve through each of the four, and a foreign
# `@scope:registry` there was read through the first three), and `pnpmfile` loads install-time code from any
# path (measured). A new key is an owner-acked edit of this list (L(-1)).
_NPMRC_KEYS = ("registry", *_LIFECYCLE_PINS)
_FROZEN_REASON = ("refused at ANY value: `true` freezes Dependabot's `pnpm install --lockfile-only` resolve "
                  "(ERR_PNPM_OUTDATED_LOCKFILE, the dead npm watch) and any other value overrides pnpm's own "
                  "CI-default freeze; CI's pin is the explicit `--frozen-lockfile` G18a (B) requires on every "
                  "workflow install - remove the setting (G18a)")
_UNLISTED_REASON = ("the committed .npmrc carries only `registry`, scoped `<scope>:registry` keys, "
                    "`enable-pre-post-scripts` and `unsafe-perm`; any other key can change what pnpm reads "
                    "(`userconfig`, `globalconfig`, `prefix` and `workspace-prefix` load a further config file, "
                    "`pnpmfile` loads install-time code, measured) - refused fail-closed; a new key is an "
                    "owner-acked edit of _NPMRC_KEYS (G18c/G18d)")
EXPECTED_ONLYBUILT_COUNT = 0          # the build-script allowlist; a bump is reviewed HERE with a box-id
_UNCOUNTABLE = 10 ** 9                 # fail-closed sentinel: an allowlist that is present but unparseable

# §0.8 JS pinned-floor (P1.60): the load-bearing JS deps the frontend/test surface relies on at a known
# floor - the JS mirror of check-supply-chain's PINNED_FLOORS. Each MUST be a DIRECT dep in pnpm-lock.yaml
# resolved at >= its floor (a drift below the relied-upon API fails HERE). Only crates ALREADY in the lock
# are listed; the rest the box names (WebdriverIO v9 + @axe-core/webdriverio) activate
# when their phase adds them - adding a row is normal growth, lowering a floor is an L(-1) review item.
# [Build-Session-Entscheidung: P1.60 - reconcile to the present §0.8 JS deps; grow as the E2E/api land.]
PINNED_FLOORS_JS = {
    "@tauri-apps/cli": "2.11.3",   # §0.4 Tauri CLI, matched to the `tauri` 2.x core pin (P1.2.3)
    "@tauri-apps/api": "2.11.1",   # §0.4 Tauri JS API the generated bindings.ts imports (P2.130 dep / P2.131 floor)
    "@tauri-apps/plugin-log": "2.8.0",  # §7.5.1 the JS log bridge (src/lib/ipc/log.ts façade; P2.95 dep-add, exact pin)
    "zustand":         "5.0.14",   # §0.4.6 UI state store (P1.31.1)
    "fast-check":      "4.8.0",    # §6.4 property-based testing (P1.35.1)
    "vitest-axe":      "0.1.0",    # §5.x a11y assertions in the vitest suite (P1.56)
}

# ---- the pnpm-lock.yaml resolution scan (G18c): a fail-closed TEXT scan, no structural YAML model ------------
# pnpm loads the lock with js-yaml and builds each fetch URL with the WHATWG URL parser
# (`new URL(tarball, registry)`), so the bytes pnpm FETCHES FROM can differ from the bytes on a line: js-yaml
# decodes a double-quoted scalar's escapes (`\x2f`, `\u002f`, `\/`, `\N`, ..., and an escaped line break that
# JOINS two source lines), and the URL parser DELETES every tab / LF / CR of its input, reads `\` as `/` and
# `http:host` as `http://host`. The 2026-09-24 G1 review measured each of these through pnpm 10.13.1's actual
# loader and dumper - @zkochan/js-yaml 0.0.7, extracted from pnpm.cjs; the repo's js-yaml 4.3.2 agrees on
# every form but the `!!binary` key, a YAML error in the zkochan loader - and Node's URL under G1 review: a
# line-based excision of the `deprecated:` notice was built and WITHDRAWN (aliases, multi-line flows, explicit
# keys, colon-bearing keys - the YAML-vs-line-model class), and a first escape decoder that turned `\t` / `\n`
# / `\r` / `\N` into real separators HID a host the URL parser joins. What stands, in this order:
#   1. decode_yaml_escapes (+ escape_problems): every double-quoted escape the loader knows is decoded over
#      the WHOLE text - the tab / LF / CR escapes to NOTHING (the URL parser deletes them, so they are never a
#      token boundary), an escaped line break joined as the loader does, a literal tab or CR deleted for the
#      same reason, an out-of-range `\U` (the loader accepts it) a fail-closed problem, not a crash.
#      Over-decoding OUTSIDE a double-quoted scalar is NOT harmless: a deletion or a join there can glue a
#      `resolution` key onto its neighbour and hide it from a decoded-only shape pass (the r5 review's
#      `{&z<TAB>resolution: ...}` and `# note\` + newline forms, measured end to end: pnpm read the key and
#      fetched). So the shape control reads the RAW text as well (item 2), and raw_text_problems refuses a
#      literal tab and a backslash at a line end outright: the two characters are exactly what the decoder
#      deletes or joins. A literal tab never appears in a dump (the dumper spells it `\t`); a line-end
#      backslash CAN - on a plain single-line value (`deprecated: Moved; install to C:\tools\`, the measured
#      dump) or on any block-scalar value line the dumper writes for multi-line free text, a notice or a
#      `peerDependencies` range (the live lock holds 42 `peerDependencies` mappings, none multi-line, and 0
#      block scalars) - and reds here by design like a URL-bearing notice: a fail-closed residual, named
#      below, never a silent pass.
#   2. resolution_shape_problems - the CONTROL, run over the RAW text AND over the DECODED text (a key hidden
#      from one pass by an escape or a deletion is bare in the other): pnpm reads a fetch location only from a
#      `resolution` key (`tarball`, `repo` + `commit`, `directory`, `type`, the older `registry`), and its own
#      dumper writes a registry package whose tarball follows the registry template as exactly
#      `    resolution: {integrity: sha...-...}` (the live lock: all 523; a package whose `dist.tarball`
#      deviates from the template keeps a `tarball` key - pnpm's toLockfileResolution, before the dumper - and
#      reds here by design). So every bare `resolution` token on either text must sit on a line of exactly
#      that shape - lines split at LF only, so a decoded U+0085 / U+2028 is content, never a line end - and a
#      line starting with a YAML indicator (`?` explicit key - which the dumper emits for a key whose quoted
#      dump exceeds 1024 characters, and which any block-scalar VALUE line, a notice or a `peerDependencies`
#      range, may begin with: two fail-closed residuals - `&` anchor, `*` alias, `!` tag, `%` directive) is
#      refused, so a key spelled through one of them cannot pass the shape check unseen (measured: js-yaml
#      reads `? resolution` + `: {...}` and a `<<: {resolution: ...}` merge as the key; the merge line carries
#      the token, the explicit key is refused by its `?`; a flow-position anchor or tag leaves the token bare
#      on the raw line). Every fetch location other than the pinned registry is thereby refused without the
#      scan having to see the URL - the registry itself is the .npmrc pin above; the token below is the key
#      pnpm's `pkgSnapshotToResolution` reads, nothing else names a fetch location - and the two-pass read
#      plus the raw refusals are what make the claim hold against the decoder's own edits. A tab / LF / CR
#      ESCAPE in plain context glues in both views, but pnpm keeps that backslash in the key (measured: an
#      anchor swallows `z\tresolution:`, a plain `\nresolution` key stays spelled so), so no `resolution` key
#      exists to hide.
#   3. lockfile_url_problems' token scan: every `scheme://host` token of the decoded text is checked against
#      the allowed host (a git / ssh / file / protocol-relative scheme is refused outright); a token ends at
#      an ASCII space, a line end or a YAML quote / flow closer ONLY, so a decoded `\N` / `\_` / NBSP inside a
#      host stays IN the host and reds, and an empty host after `://` reds. With 2 in place this is defence in
#      depth for a URL outside a resolution - and the posture: a `deprecated:` notice that names a URL is a
#      RED by design, the signal to move off the deprecated package (the eslint@9 case of 2026-09-24), never a
#      scan exemption.
# Named residuals - the same seven items stand in the G18c row, the Loop-memory and the commit body.
# Fail-closed (a red by design; the remedy is a dependency bump or a re-audit, never a scan exemption): a
# notice whose text carries a bare `resolution` token, or a dependency literally named `resolution`; a
# block-scalar value line (a notice, a `peerDependencies` range) starting with `?` / `&` / `*` / `!` / `%`, or
# a value line - plain or block-scalar - ending in a backslash; a package key whose quoted dump exceeds 1024
# characters (spelled as a `? ` explicit key); a registry package whose `dist.tarball` deviates from the
# registry template (pnpm keeps its `tarball`). Fetch-free (the TOKEN scan, item 3, is not the control; a
# notice fetches nothing and a resolution is caught by its shape): any URL a notice spells without `scheme://`
# for the five schemes the token regex knows - http, https, ssh, git, file (`http:host`, `http:\\host`) - and
# any scheme outside that set (`ftp://`, `svn://`); a URL split across a block scalar's lines or folded over a
# blank line inside a double-quoted notice (the loader emits an LF the URL parser deletes); a host cut by a
# decoded `\"` / `\x27` (`'`) / `\x7d` (`}`) or by a literal `'` / `}` inside a double-quoted notice (a
# URL-valid, DNS-dependent host).

# js-yaml's complete double-quoted escape grammar (readDoubleQuotedScalar): `\x..` / `\u....` / `\U........`,
# the single-character set, `\` + TAB (a tab) and `\` + line break (the join: the break and the next line's
# leading whitespace vanish, as the loader's skipSeparationSpace does)
_YAML_ESCAPE_RE = re.compile(
    r"\\(?:x([0-9A-Fa-f]{2})|u([0-9A-Fa-f]{4})|U([0-9A-Fa-f]{8})|(\r\n|\n|\r)[ \t\r\n]*|([0abtnvfre \"/\\N_LP\t]))")
_YAML_SIMPLE_ESCAPES = {"0": "\0", "a": "\a", "b": "\b", "t": "\t", "\t": "\t", "n": "\n", "v": "\v", "f": "\f",
                        "r": "\r", "e": "\x1b", " ": " ", '"': '"', "/": "/", "\\": "\\", "N": "\x85",
                        "_": "\xa0", "L": "\u2028", "P": "\u2029"}
_URL_PARSER_DELETES = "\t\n\r"        # the WHATWG URL parser removes these from its input before parsing
_MAX_CODEPOINT = 0x10FFFF


def escape_problems(text: str) -> list[str]:
    """(pure) Every `\\U` escape whose code point exceeds U+10FFFF: js-yaml's loader accepts it (it emits a
    surrogate pair with no range check), Python cannot spell it - a fail-closed problem, never a crash."""
    return [f"pnpm-lock.yaml carries the out-of-range escape `\\U{m.group(3)}` (> U+10FFFF) this scan cannot "
            "decode - fail-closed (G18c)"
            for m in _YAML_ESCAPE_RE.finditer(text) if m.group(3) and int(m.group(3), 16) > _MAX_CODEPOINT]


def decode_yaml_escapes(text: str) -> str:
    """(pure) The text as pnpm's loader + URL parser read it: every js-yaml double-quoted escape replaced by
    its character (`\\x2f` -> `/`, `\\N` -> U+0085, ...), an escaped line break joined, the tab / LF / CR
    escapes and every literal tab / CR DELETED (the URL parser deletes them), an out-of-range `\\U` replaced
    by U+FFFD (escape_problems reports it). A backslash starting no known sequence is kept (a plain scalar's
    `C:\\x is gone`). Over-decoding outside a double-quoted scalar can delete or join (the module comment,
    item 1), which is why the shape control also reads the raw text and raw_text_problems runs first."""
    def one(m: "re.Match[str]") -> str:
        hexes = m.group(1) or m.group(2) or m.group(3)
        if hexes:
            cp = int(hexes, 16)
            ch = chr(cp) if cp <= _MAX_CODEPOINT else "\ufffd"
        elif m.group(4) is not None:
            return ""                                   # the escaped line break: a join
        else:
            ch = _YAML_SIMPLE_ESCAPES[m.group(5)]
        return "" if ch in _URL_PARSER_DELETES else ch
    return _YAML_ESCAPE_RE.sub(one, text).replace("\t", "").replace("\r", "")


# the raw refusals (the module comment, item 1): the two characters the decoder deletes or joins
_LINE_END_BACKSLASH_RE = re.compile(r"\\\r?$")


def raw_text_problems(lock_text: str) -> list[str]:
    """(pure) A literal tab anywhere and a backslash at a line end - the two spellings whose deletion / join
    by the decoder could glue a key onto its neighbour (the r5 review's forms). A dump never carries a
    literal tab (spelled `\\t`); it can carry a value line - plain or block-scalar, a notice or a
    `peerDependencies` range - ending in a backslash, which then reds here by design (a named residual).
    Each is refused outright, before either shape pass."""
    problems: list[str] = []
    for n, line in enumerate(lock_text.split("\n"), 1):
        if "\t" in line:
            problems.append(f"pnpm-lock.yaml:{n} carries a literal tab - pnpm's dumper spells a tab `\\t`; the URL "
                            "parser deletes a tab and the decoder would glue the neighbours; refused (G18c)")
        if _LINE_END_BACKSLASH_RE.search(line):
            problems.append(f"pnpm-lock.yaml:{n} ends with a backslash - outside a double-quoted scalar the decoder "
                            "would join it to the next line and glue that line's key onto this one; refused by "
                            "design (a value line ending in a backslash, plain or block-scalar, is a red like a "
                            "URL-bearing notice - G18c)")
    return problems


# the shape control (the module comment, item 2)
_YAML_INDICATOR_LINE_RE = re.compile(r"^[ \t]*([?&*!%])")
_RESOLUTION_TOKEN_RE = re.compile(r"(?<![\w@/.-])resolution(?![\w@/.-])")
_CANONICAL_RESOLUTION_RE = re.compile(r"^ {4}resolution: \{integrity: sha(?:1|256|512)-[A-Za-z0-9+/]+={0,2}\}$")


def resolution_shape_problems(text: str) -> tuple[list[str], int]:
    """(pure) Over ONE view of the lock text (the caller runs it over the raw text and over the decoded text):
    every line carrying a bare `resolution` token must be the one registry shape pnpm's dumper writes, and
    no line may start with a YAML indicator (the dumper emits `? ` for a key whose quoted dump exceeds 1024
    characters, and any block-scalar value line - a notice, a `peerDependencies` range - may begin with one:
    fail-closed residuals, measured). Lines are split at LF only (a decoded U+0085 / U+2028 stays inside its
    line). Returns (problems, the count of canonical resolution lines) - the count so a caller can prove the
    check was not vacuous."""
    problems: list[str] = []
    canonical = 0
    for n, line in enumerate(text.split("\n"), 1):
        ind = _YAML_INDICATOR_LINE_RE.match(line)
        if ind:
            problems.append(f"pnpm-lock.yaml:{n} starts with the YAML indicator {ind.group(1)!r} (explicit key / "
                            "anchor / alias / tag / directive) - pnpm's dumper writes one only as the `? ` of a key "
                            "whose quoted dump exceeds 1024 characters or on a block-scalar value line - a "
                            "notice, a `peerDependencies` range (a fail-closed residual); a key spelled "
                            "through it is unreadable to this scan; refused (G18c)")
            continue
        if not _RESOLUTION_TOKEN_RE.search(line):
            continue
        if _CANONICAL_RESOLUTION_RE.match(line):
            canonical += 1
            continue
        problems.append(f"pnpm-lock.yaml:{n} `resolution` outside the one registry shape pnpm's dumper writes "
                        f"(`resolution: {{integrity: sha...-...}}`): {line.strip()[:80]!r} - every fetch "
                        "location other than the pinned registry (a tarball URL, a git repo, a directory, a "
                        "file:) is refused by shape (G18c)")
    return problems, canonical


# URL tokens (the module comment, item 3): any scheme://... (incl. git+ssh / git+https / ssh / git / file)
# OR a protocol-relative //host.tld/... (the leading-// guarded to a dotted host so a base64 integrity hash
# that happens to contain `//` is not matched). A token ends at an ASCII space, a line end or a YAML quote /
# flow closer ONLY - never at a control or non-ASCII whitespace character, which stays in the host and reds
# - and `://` followed by a boundary is a token with an EMPTY host (fail-closed), never a non-match.
_RESOLUTION_RE = re.compile(
    r"(?:(?:git\+)?(?:https?|ssh|git|file):)//[^ \n'\"}\]]*"
    r"|(?<![\w./:])//[a-z0-9-]+(?:\.[a-z0-9-]+)+/[^ \n'\"}\]]*",
    re.IGNORECASE,
)


def fail(msg: str) -> None:
    print(f"[G18c/d] FAIL: {msg}", file=sys.stderr)


# The .npmrc reader: pnpm 10.13.1 reads .npmrc with the `ini` decode bundled in pnpm.cjs, then passes each
# key through @pnpm/npm-conf, so this reader follows that code, and each spelling below was measured through
# pnpm 10.13.1 itself. Lines split at CR/LF runs; a line whose first non-blank character is `;` or `#` is a
# comment; keys and values are trimmed with JavaScript's whitespace set (U+FEFF included, which Python's
# strip() leaves); a value wrapped in "..." or '...' is JSON-decoded, and any other value ends at its first
# unescaped `;` or `#` (an inline comment); a bare key (no `=`) reads as `true`; a line whose value holds
# U+2028 or U+2029 is skipped (a JavaScript `.` stops at them); keys are case-sensitive (`REGISTRY` is not
# `registry`) and the last spelling of a key wins. What a static read cannot settle is refused fail-closed
# (npmrc_unmodelled_problems): a `[section]` header (pnpm reads `[frozen-lockfile]` as that key, and moves
# every key after a header out of the top level), an array key `name[]` (pnpm collects the key into a list),
# a key holding `${` (npm-conf substitutes the environment into keys: `${UNSET-frozen-lockfile}` reads as
# `frozen-lockfile`) and a quoted key that decodes to a non-string JSON value (`'["unsafe-perm"]'` reads as
# `unsafe-perm`). A key the reader reads outside _NPMRC_KEYS is refused by evaluate_npmrc.
_JS_WS = ("\t\n\v\f\r \u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a"
          "\u2028\u2029\u202f\u205f\u3000\ufeff")
_INI_LINE_SPLIT_RE = re.compile(r"[\r\n]+")


def _reject_json_constant(name: str) -> object:
    raise ValueError(f"JSON.parse has no {name}")


def _ini_unsafe(raw: str) -> tuple[str, bool]:
    """(pure) The `ini` package's unsafe() on one key or value: (the text pnpm reads, whether that is a string).
    A text wrapped in "..." or '...' is JSON-decoded (a single-quoted one after its quotes are dropped) and kept
    as it stands when the decode fails; any other text ends at its first unescaped `;` or `#`, where `\\;`,
    `\\#` and `\\\\` unescape and every other backslash stays. A non-string JSON result comes back as its JSON
    text with False, as does a nesting too deep for Python's decoder (JavaScript decodes it)."""
    val = raw.strip(_JS_WS)
    if val[:1] in ("\"", "'") and val.endswith(val[:1]):
        body = val[1:-1] if val[0] == "'" else val
        try:
            decoded = json.loads(body, parse_constant=_reject_json_constant)
        except RecursionError:
            return body, False
        except ValueError:
            return body, True
        if isinstance(decoded, str):
            return decoded, True
        return json.dumps(decoded), False
    out: list[str] = []
    escaped = False
    for ch in val:
        if escaped:
            out.append(ch if ch in "\\;#" else "\\" + ch)
            escaped = False
        elif ch in ";#":
            break
        elif ch == "\\":
            escaped = True
        else:
            out.append(ch)
    if escaped:
        out.append("\\")
    return "".join(out).strip(_JS_WS), True


def _read_npmrc(text: str) -> tuple[dict[str, str], list[str]]:
    """(pure) The .npmrc as pnpm 10.13.1 reads it (the reader block above): (the top-level key -> value map,
    the fail-closed problems for each spelling a static read cannot settle)."""
    cfg: dict[str, str] = {}
    problems: list[str] = []
    for line in _INI_LINE_SPLIT_RE.split(text):
        lead = line.lstrip(_JS_WS)
        if not lead or lead[0] in ";#":
            continue                                    # a blank or comment line
        if lead[0] == "[":
            problems.append(f".npmrc line {lead.rstrip(_JS_WS)[:80]!r} is (or reads like) an ini `[section]` "
                            "header - pnpm reads `[name]` as a key `name` holding an object (`[frozen-lockfile]` "
                            "freezes the resolve, measured) and moves every key after a header out of the top "
                            "level, which this guard does not model; refused fail-closed - keep .npmrc a flat "
                            "list of `key=value` lines (G18c/G18d)")
            continue
        key_part, eq, rest = line.partition("=")
        if not key_part or (eq and ("\u2028" in rest or "\u2029" in rest)):
            continue                                    # ini's line pattern does not match: pnpm skips the line
        key, key_is_str = _ini_unsafe(key_part)
        if not key_is_str:
            problems.append(f".npmrc key {key_part.strip(_JS_WS)[:80]!r} decodes to the JSON value {key[:80]} - "
                            "pnpm makes it a key by string conversion (`'[\"unsafe-perm\"]'` reads as "
                            "`unsafe-perm`, measured); refused fail-closed (G18c/G18d)")
            continue
        if len(key) > 2 and key.endswith("[]"):
            key = key[:-2]
            problems.append(f".npmrc key `{key}[]` is an ini array key - pnpm collects `{key}` into a list, "
                            "which this guard does not model; refused fail-closed (G18c/G18d)")
        if key == "__proto__":
            continue                                    # ini drops it
        if "${" in key:
            problems.append(f".npmrc key `{key}` holds `${{` - npm-conf substitutes the environment into a key "
                            "(`${UNSET-frozen-lockfile}` reads as `frozen-lockfile`, measured), which a static "
                            "read cannot settle; refused fail-closed (G18c/G18d)")
        cfg[key] = _ini_unsafe(rest)[0] if eq else "true"
    return cfg, problems


def parse_npmrc(text: str) -> dict[str, str]:
    """(pure) The top-level .npmrc key -> value map as pnpm 10.13.1 reads it (_read_npmrc)."""
    return _read_npmrc(text)[0]


def npmrc_unmodelled_problems(text: str) -> list[str]:
    """(pure) The fail-closed refusals for the .npmrc spellings a static read cannot settle (_read_npmrc)."""
    return _read_npmrc(text)[1]


def evaluate_npmrc(cfg: dict[str, str]) -> list[str]:
    """(pure) Registry-pin + lifecycle-lockdown + committed-frozen-lockfile + unlisted-key problems in the
    parsed .npmrc."""
    problems: list[str] = []
    if cfg.get("registry") != ALLOWED_REGISTRY:
        problems.append(f"`registry` is {cfg.get('registry')!r}, not the pinned {ALLOWED_REGISTRY!r} - "
                        "an unpinned/foreign registry is the dependency-confusion surface (G18c)")
    # a scoped (@scope:registry) or per-host (//host/:registry) override to any other origin is the
    # source-substitution vector even when the default registry stays pinned
    for key, val in cfg.items():
        if key != "registry" and key.endswith(":registry"):
            if val.rstrip("/") != ALLOWED_REGISTRY.rstrip("/"):
                problems.append(f"scoped/per-registry override `{key}={val}` points off the allowed "
                                f"origin - a scoped dep would resolve from it (source-substitution, G18c)")
    for key, why in _LIFECYCLE_PINS.items():
        if cfg.get(key) != "false":
            shown = repr(cfg[key]) if key in cfg else "absent"
            problems.append(f"`{key}` is {shown}, not the pinned `false` - pnpm reads an absent key and every "
                            f"value but `false` as ON; {why} (G18d)")
    for key, val in cfg.items():
        if _FROZEN_KEY_RE.fullmatch(key):
            problems.append(f"`{key}={val}` is committed in .npmrc - {_FROZEN_REASON}")
        elif key not in _NPMRC_KEYS and not key.endswith(":registry"):
            problems.append(f".npmrc key `{key}` is not one this guard evaluates - {_UNLISTED_REASON}")
    return problems


def lockfile_url_problems(lock_text: str) -> list[str]:
    """(pure) The G18c lock scan (the module comment): the raw refusals and the escape problems, the
    resolution SHAPE control over the raw text and over the decoded text, then the token scan over the
    decoded text - a URL must be from the allowed host and any non-registry scheme (git/ssh/file/
    protocol-relative = clone-and-build / off-registry) is rejected. Nothing is excised."""
    problems = raw_text_problems(lock_text) + escape_problems(lock_text)
    decoded = decode_yaml_escapes(lock_text)
    problems += resolution_shape_problems(lock_text)[0]      # the RAW pass (a key the decoder would glue)
    problems += resolution_shape_problems(decoded)[0]        # the DECODED pass (a key an escape spells)
    problems = list(dict.fromkeys(problems))                 # the same line may red identically in both passes
    for token in _RESOLUTION_RE.findall(decoded):
        low = token.lower()
        if low.startswith(("https://", "http://")):
            host = token.split("://", 1)[1].split("/", 1)[0].lower()
            if host != ALLOWED_HOST:
                problems.append(f"pnpm-lock.yaml resolves from a non-allowed host: {token} (only "
                                f"{ALLOWED_HOST} is permitted - G18c)")
        else:
            problems.append(f"pnpm-lock.yaml has a non-registry resolution scheme: {token} (git/ssh/file/"
                            "protocol-relative resolutions are clone-and-build / off-registry - G18c)")
    return problems


def _list_count_under(text: str, key: str) -> int | None:
    """(pure) Count a YAML list under `key:` - inline `[a, b]` / empty `[]` / a block of `- item` lines
    (comment + blank lines skipped); None if `key` is absent."""
    inline = re.search(rf"(?m)^{re.escape(key)}:\s*\[([^\]]*)\]\s*$", text)
    if inline is not None:
        return len([x for x in inline.group(1).split(",") if x.strip()])
    m = re.search(rf"(?m)^{re.escape(key)}:\s*$", text)
    if not m:
        return None
    count = 0
    for line in text[m.end():].splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue                                  # skip blanks + comment lines inside the block
        if re.match(r"^\s*-\s+\S", line):
            count += 1
        elif not line.startswith((" ", "\t")):
            break                                     # a new top-level key ends the list
    return count


def workspace_onlybuilt_count(text: str) -> int | None:
    """(pure) The onlyBuiltDependencies list size in a pnpm-workspace.yaml; None if the key is absent."""
    return _list_count_under(text, "onlyBuiltDependencies")


def _workspace_token_found(ws_text: str, token_re: re.Pattern[str]) -> bool:
    """(pure) Whether `token_re` finds a token in the raw pnpm-workspace.yaml text or in its escape-decoded
    text, with nothing excised (workspace_frozen_lockfile_problems says why each view is needed)."""
    return any(token_re.search(view) for view in (ws_text, decode_yaml_escapes(ws_text)))


def workspace_registries_problems(text: str) -> list[str]:
    """(pure) pnpm-workspace.yaml has a first-class `registries` map (a `default` registry + per-scope
    `\"@scope\"` registries) that pnpm reads over the .npmrc pin - the YAML analogue of the .npmrc registry
    pin / scoped-registry override (G18c); it re-pointed resolution in the block, flow and quoted form
    (measured), which a `^registries:` line read does not see. The registry pin lives in .npmrc only, so a
    `registries` token there is refused at any value (the pnpm-workspace.yaml block above)."""
    if _workspace_token_found(text, _REGISTRIES_TOKEN_RE):
        return ["pnpm-workspace.yaml carries a `registries` token (raw or escape-decoded, a comment included - "
                "nothing is excised) - pnpm reads a pnpm-workspace.yaml `registries` map over the .npmrc pin (it "
                "re-pointed resolution in the block, flow and quoted form, measured); the registry pin lives in "
                ".npmrc only - remove it (G18c)"]
    return []


def workspace_env_problems(ws_text: str) -> list[str]:
    """(pure) pnpm substitutes the environment into every top-level pnpm-workspace.yaml key and string value
    (the pnpm-workspace.yaml block above), so a key composed across `${` hides every token search here
    (`${UNSET-frozen}Lockfile: true` froze the lockfile-only resolve, measured). A `${` anywhere in the file,
    raw or escape-decoded (a double-quoted `\\x24{` decodes to one, and pnpm substituted it, measured), is
    refused fail-closed (G18c/G18d)."""
    if _workspace_token_found(ws_text, _ENV_EXPR_RE):
        return ["pnpm-workspace.yaml carries `${` (raw or escape-decoded, a comment included - nothing is "
                "excised) - pnpm substitutes the environment into that file's keys and string values "
                "(`${UNSET-frozen}Lockfile: true` froze the lockfile-only resolve and `${UNSET-regis}tries` "
                "re-pointed resolution, measured), which a static read cannot settle; refused fail-closed "
                "(G18c/G18d)"]
    return []


def workspace_frozen_lockfile_problems(ws_text: str) -> list[str]:
    """(pure) pnpm-workspace.yaml carries pnpm settings as well, so a `frozenLockfile` or
    `frozenLockfileIfExists` there is the same committed setting the .npmrc refusal covers (G18a); both
    froze the lockfile-only resolve (measured). pnpm 10.13.1 reads the key as a block, flow, JSON,
    explicit (`? `), anchored-and-aliased, merged (`<<:`) or env-fallback (`${UNSET-frozenLockfile}`) key and
    through a double-quoted escape (`\\x4C`, `\\u004C`, an escaped line break) - each measured; a key composed
    across `${` (`${UNSET-frozen}Lockfile`) is workspace_env_problems' refusal - so the token
    is searched in the escape-decoded text and in the raw text (the decoder glues a key onto a plain value
    that ends in a backslash on the line before, which pnpm reads as two lines, measured), and nothing is
    excised: a line starting with `#` inside a multi-line quoted flow scalar is live YAML (measured), so a
    comment naming the setting is refused as well."""
    if _workspace_token_found(ws_text, _FROZEN_TOKEN_RE):
        return ["pnpm-workspace.yaml carries a `frozenLockfile` token (or `frozenLockfileIfExists`; raw or "
                f"escape-decoded, a comment included - nothing is excised) - {_FROZEN_REASON}"]
    return []


def workspace_lifecycle_problems(ws_text: str) -> list[str]:
    """(pure) pnpm copies every pnpm-workspace.yaml key over the .npmrc lifecycle pins (the _LIFECYCLE_PINS
    comment), so a token naming either pin there is refused at any value, searched as the frozen token is
    (G18d)."""
    if _workspace_token_found(ws_text, _LIFECYCLE_TOKEN_RE):
        return ["pnpm-workspace.yaml carries an `enablePrePostScripts` / `unsafePerm` token (raw or escape-decoded, "
                "a comment included - nothing is excised) - pnpm reads a pnpm-workspace.yaml setting over the "
                ".npmrc pin (`enablePrePostScripts: true` ran the root project's `pre<script>` with the .npmrc "
                "pin at `false`, measured); the lifecycle pins live in .npmrc only - remove it (G18d)"]
    return []


_BUILD_ALLOWLIST_KEYS = ("onlyBuiltDependencies", "allowBuilds")   # pnpm 10 / pnpm 11


def onlybuilt_count() -> int | None:
    """The pnpm build-script allowlist size, None if no pnpm manifest / key exists (target-absent), or
    the fail-closed sentinel _UNCOUNTABLE if a manifest declares the key in a form we cannot count."""
    if PACKAGE_JSON.is_file():
        try:
            pkg = json.loads(PACKAGE_JSON.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            return _UNCOUNTABLE
        pnpm = pkg.get("pnpm") if isinstance(pkg.get("pnpm"), dict) else {}
        for key in _BUILD_ALLOWLIST_KEYS:
            v = pnpm.get(key)
            if isinstance(v, list):
                return len(v)
            if v is not None:
                return _UNCOUNTABLE                   # present but not a list -> fail-closed
    if PNPM_WORKSPACE.is_file():
        text = PNPM_WORKSPACE.read_text(encoding="utf-8")
        for key in _BUILD_ALLOWLIST_KEYS:
            n = _list_count_under(text, key)
            if n is not None:
                return n
        if re.search(r"(?m)^\s*(onlyBuiltDependencies|allowBuilds):", text):
            return _UNCOUNTABLE                        # the key is present but unparseable -> fail-closed
    return None


def nonroot_npmrc(root: Path) -> list[Path]:
    """Every committed `.npmrc` OUTSIDE the repo root (pnpm reads per-directory .npmrc, so a subdir one
    could re-point the registry / unlock scripts unseen by the root-only scan). node_modules/.git/build
    dirs excluded."""
    root_npmrc = root / ".npmrc"
    out = []
    for p in root.rglob(".npmrc"):
        if p == root_npmrc:
            continue
        if any(part in _SKIP_DIRS for part in p.relative_to(root).parts):
            continue
        out.append(p)
    return out


def _redirect_specs_in_map(label: str, d: object) -> list[str]:
    """(pure) Flag every {name: spec} entry whose spec is a SOURCE redirect (_REDIRECT_SPEC) - used for
    package.json dependency/override/resolution maps. A plain version / npm: / workspace: stays clean."""
    out: list[str] = []
    if isinstance(d, dict):
        for k, v in d.items():
            if isinstance(v, str) and _REDIRECT_SPEC.match(v):
                out.append(f"`{label}.{k}` = {v!r} is a SOURCE-redirect spec (file/link/portal/git/url) - "
                           "a local/off-registry dependency the resolution-URL guard cannot see; forbidden")
    return out


def _yaml_redirect_block(text: str, key: str) -> list[str]:
    """(pure) Flag source-redirecting values under a top-level `key:` map (overrides/resolutions) in a
    pnpm-workspace.yaml - a `file:`/`link:`/`portal:`/`git`/url target replaces a dependency's SOURCE
    (the URL guard cannot see a local-path redirect). pnpm 11 reads overrides ONLY from this yaml (it
    dropped the package.json `pnpm` field), so this is the PRIMARY override location. Fail-closed on an
    inline/anchor form. A plain version pin (^1.2.3) and an npm:-alias (the reserved-G18e name residual)
    stay clean."""
    problems: list[str] = []
    # [^\S\n] = horizontal whitespace only (NOT a newline) so a same-line check cannot cross into a
    # following block body
    inline = re.search(rf"(?m)^{key}:[^\S\n]*\{{(.*)\}}[^\S\n]*$", text)
    if inline is not None:
        for part in inline.group(1).split(","):
            if ":" in part:
                v = part.split(":", 1)[1].strip().strip("\"'")
                if _REDIRECT_SPEC.match(v):
                    problems.append(f"pnpm-workspace.yaml `{key}` redirects a dependency SOURCE ({v}) - "
                                    "a local/off-registry override the URL guard cannot see; forbidden")
        return problems
    m = re.search(rf"(?m)^{key}:[^\S\n]*$", text)        # block header (only whitespace after the colon)
    if not m:
        if re.search(rf"(?m)^{key}:[^\S\n]*\S", text):   # same-line scalar/anchor that is not a {map}
            return [f"pnpm-workspace.yaml `{key}:` is in an inline/anchor form this guard cannot parse - "
                    "fail-closed; write it as a plain block of `name: spec` lines (G18d)"]
        return problems
    for line in text[m.end():].splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        if not line.startswith((" ", "\t")):
            break
        mm = re.match(r"\s+(\S+)\s*:\s*(\S.*)$", line)
        if mm:
            v = mm.group(2).strip().strip("\"'")
            if _REDIRECT_SPEC.match(v):
                problems.append(f"pnpm-workspace.yaml `{key}.{mm.group(1).strip(chr(34) + chr(39))}` "
                                f"redirects a dependency SOURCE ({v}) - a local/off-registry override the "
                                "URL guard cannot see; forbidden")
    return problems


def install_mutation_problems(pkg: dict, ws_text: str, patches_present: bool) -> list[str]:
    """(pure) Committed config that MUTATES a dependency's source or runs install-time code while its
    resolution URL stays the legitimate registry - the class the .pnpmfile.cjs forbid opened: pnpm
    `patchedDependencies` + a `patches/` dir; a SOURCE-redirect spec (file/link/portal/git/url) in any
    dependency-spec location - package.json dependencies/devDependencies/optionalDependencies/
    peerDependencies/overrides/resolutions AND pnpm-workspace.yaml overrides/resolutions/catalog/
    catalogs (plus a source-redirect prefix anywhere in that file); and root install-lifecycle scripts.
    Forbidden outright in a zero-egress product; in pnpm-workspace.yaml each outright-refused setting is a
    token search at any value (the pnpm-workspace.yaml block at the top of this file). (A
    subdir package.json in a future multi-package workspace is a P1-activation refinement - only the
    root package.json + workspace yaml exist in v1's single front-end package.)"""
    problems: list[str] = []
    pnpm = pkg.get("pnpm") if isinstance(pkg.get("pnpm"), dict) else {}
    # In pnpm-workspace.yaml each setting refused below is a token search at any value (the pnpm-workspace.yaml
    # block at the top of this file: pnpm read each of them from the block, quoted, flow and explicit key forms)
    if pnpm.get("patchedDependencies") or _workspace_token_found(ws_text, _PATCHED_DEPS_TOKEN_RE) \
            or patches_present:
        problems.append("a committed pnpm `patchedDependencies` / `patches/` exists - an install-time "
                        "patch mutates a third-party dependency's source (the resolution URL stays "
                        "npmjs.org, so the URL guard is blind to it); forbidden in a zero-egress product")
    # a source-redirect spec (file:/link:/portal:/git+/ssh/url) is the same SOURCE-mutation class whether
    # it sits in a direct dependency field, an override, or a version catalog - scan EVERY committed
    # location that carries a dependency spec, in package.json AND pnpm-workspace.yaml (pnpm 11 reads
    # overrides/catalogs only from the yaml). A plain version pin (^1.2.3) / npm:-alias (G18e name
    # residual) / workspace: (legit monorepo link) stay clean.
    # configDependencies (pnpm 10): a registry-sourced config PACKAGE installed before graph resolution,
    # whose documented role is to supply .pnpmfile.cjs hooks + patch files + the build allowlist - it
    # defeats the .pnpmfile.cjs + patchedDependencies + allowlist forbids at once, behind a clean
    # registry tarball the URL guard cannot flag. Forbidden outright.
    if pnpm.get("configDependencies") or _workspace_token_found(ws_text, _CONFIG_DEPS_TOKEN_RE):
        problems.append("a committed pnpm `configDependencies` exists - a registry-sourced config package "
                        "injects install-time hooks / patches / the build-script allowlist BEFORE graph "
                        "resolution (defeating the .pnpmfile.cjs + patchedDependencies + allowlist forbids "
                        "behind a clean registry tarball); forbidden in a zero-egress product")
    # onlyBuiltDependenciesFile: a FILE pointer for the build allowlist sidesteps the inline count guard
    if pnpm.get("onlyBuiltDependenciesFile") or _workspace_token_found(ws_text, _ONLYBUILT_FILE_TOKEN_RE):
        problems.append("`onlyBuiltDependenciesFile` points the build-script allowlist at a separate file, "
                        "sidestepping the inline count - keep the allowlist inline (G18d)")
    # dangerouslyAllowAllBuilds (pnpm 10.9.0+): runs EVERY dependency's build/lifecycle script with no
    # allowlist - one key re-opens the whole lifecycle-code-exec surface G18d locks down. pnpm copies the
    # raw js-yaml value into config and gates on a BARE truthiness check (`if (opts.dangerouslyAllowAll
    # Builds)`), so ANY JS-truthy scalar (true/True/yes/on/y/enabled/1/"true"/!!bool true) enables it, and a
    # line read cannot settle the value (`false` plus a more-indented continuation line is the truthy plain
    # scalar `false on`, measured): in pnpm-workspace.yaml the token is refused at any value.
    if pnpm.get("dangerouslyAllowAllBuilds") or _workspace_token_found(ws_text, _ALLOW_ALL_BUILDS_TOKEN_RE):
        problems.append("`dangerouslyAllowAllBuilds` is set (in pnpm-workspace.yaml: the token at any value, raw "
                        "or escape-decoded, a comment included) - it auto-runs EVERY dependency's build/"
                        "lifecycle script with NO allowlist (bypasses the onlyBuiltDependencies guard "
                        "entirely); forbidden (G18d)")
    # packageExtensions: injects dependency sub-maps into a third-party package's manifest at resolve
    # time - scan the injected specs for the same source-redirect class
    pkg_ext = pnpm.get("packageExtensions")
    if isinstance(pkg_ext, dict):
        for ext_pkg, ext in pkg_ext.items():
            if isinstance(ext, dict):
                for field in ("dependencies", "peerDependencies", "optionalDependencies"):
                    problems += _redirect_specs_in_map(f"packageExtensions.{ext_pkg}.{field}", ext.get(field))
    for label in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies"):
        problems += _redirect_specs_in_map(label, pkg.get(label))
    problems += _redirect_specs_in_map("pnpm.overrides", pnpm.get("overrides"))
    problems += _redirect_specs_in_map("resolutions", pkg.get("resolutions"))
    for key in ("overrides", "resolutions", "catalog", "catalogs"):
        problems += _yaml_redirect_block(ws_text, key)
    # the block reader above names the key; the control is the prefix token anywhere in the file (the
    # pnpm-workspace.yaml block at the top of this file: a flow-form `overrides` and a hex-escaped `link:` value
    # each rewrote a dependency to a local link that the block reader did not see, measured)
    if _workspace_token_found(ws_text, _REDIRECT_TOKEN_RE):
        problems.append("pnpm-workspace.yaml carries a source-redirect spec prefix (`file:` / `link:` / `portal:` / "
                        "`git+` / `git:` / `ssh:` / `http:` / `https:`; raw or escape-decoded, a comment included - "
                        "nothing is excised) - pnpm reads a dependency spec from any key form and through an escape "
                        "(a flow-form `overrides` and a hex-escaped `link:` value each rewrote a dependency to a "
                        "local link, measured); refused wherever it appears (G18d)")
    scripts = pkg.get("scripts") if isinstance(pkg.get("scripts"), dict) else {}
    for hook in _INSTALL_HOOKS:
        if hook in scripts:
            problems.append(f"root package.json `{hook}` script runs install-time code in the secret-"
                            "bearing CI job - a zero-egress product ships no install-time scripts")
    return problems


def _parse_ver(v: str):
    """(release, pre) for 'X.Y.Z[-pre][+build]' by semver precedence; None if the release core is not
    three ints (caller fails closed). Mirrors check-supply-chain's comparator (standalone gate scripts)."""
    core = v.strip().split("+", 1)[0]
    rel, _, pre = core.partition("-")
    parts = rel.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        return None
    pre_ids = [((0, int(i)) if i.isdigit() else (1, i)) for i in (pre.split(".") if pre else [])]
    return (tuple(int(p) for p in parts), tuple(pre_ids))


def _version_ge(have: str, floor: str):
    """have >= floor by semver precedence; None if either is unparseable (caller fails closed)."""
    a, b = _parse_ver(have), _parse_ver(floor)
    if a is None or b is None:
        return None
    (arel, apre), (brel, bpre) = a, b
    if arel != brel:
        return arel > brel
    if not apre and not bpre:
        return True
    if not apre:
        return True
    if not bpre:
        return False
    return apre >= bpre


def _direct_dep_versions(lock_text: str, names: set[str]) -> dict[str, list[str]]:
    """Resolved versions of each named DIRECT dependency from the pnpm-lock.yaml `importers` section (the
    6-space dep-name key -> its 8-space `version:`; pnpm v9 peer-dep context in parens is stripped). A
    crate may resolve more than once across importers, so each is a LIST. stdlib only (regex over YAML)."""
    out: dict[str, list[str]] = {n: [] for n in names}
    in_importers = False
    current: str | None = None
    for line in lock_text.splitlines():
        if re.match(r"^importers:\s*$", line):
            in_importers = True
            continue
        if in_importers and re.match(r"^\S", line):       # a new top-level key ends the importers block
            break
        if not in_importers:
            continue
        mk = re.match(r"^ {6}'?([^':]+)'?:\s*$", line)     # a 6-space dependency-name key
        if mk:
            current = mk.group(1) if mk.group(1) in out else None
            continue
        if current is not None:
            mv = re.match(r"^ {8}version:\s*([0-9][^\s(]*)", line)   # 8-space version; strip peer-context
            if mv:
                out[current].append(mv.group(1))
                current = None
    return out


def _pinned_floor_assertion() -> list[str]:
    """§0.8 JS pinned-floor (P1.60): each PINNED_FLOORS_JS crate must be a DIRECT dep in pnpm-lock.yaml
    resolved at >= its floor. A listed crate ABSENT from the importers is a FAIL (a relied-upon dep
    vanished); an unparseable version is a FAIL (fail-closed). The floor is satisfied if ANY resolved copy
    is >= floor. Target-absent (no lockfile yet) returns clean - the resolution-URL guard already
    skip-noticed."""
    if not PNPM_LOCK.is_file():
        return []
    found = _direct_dep_versions(PNPM_LOCK.read_text(encoding="utf-8"), set(PINNED_FLOORS_JS))
    problems: list[str] = []
    for crate, floor in sorted(PINNED_FLOORS_JS.items()):
        have = found.get(crate) or []
        if not have:
            problems.append(f"§0.8 JS floor crate `{crate}` (>= {floor}) is not a direct dep in "
                            "pnpm-lock.yaml - a relied-upon dependency vanished; restore it or remove the "
                            "floor row HERE (L(-1)) with a box-id")
            continue
        ges = [_version_ge(v, floor) for v in have]
        if any(g is True for g in ges):
            continue
        if any(g is None for g in ges):
            problems.append(f"§0.8 JS floor crate `{crate}`: an unparseable version among {sorted(have)} "
                            f"(floor {floor!r}) - failing closed")
        else:
            problems.append(f"§0.8 JS floor crate `{crate}` is present only at {sorted(have)} < its pinned "
                            f"floor {floor} - a drift below the relied-upon API floor; bump the dep or lower "
                            "the floor HERE (L(-1)) with a box-id + Dual-Review note")
    return problems


def main() -> int:
    if not NPMRC.is_file():
        print(f"[G18c/d] {NPMRC} missing", file=sys.stderr)
        return 2
    npmrc_text = NPMRC.read_text(encoding="utf-8")
    problems = evaluate_npmrc(parse_npmrc(npmrc_text)) + npmrc_unmodelled_problems(npmrc_text)
    for sub in nonroot_npmrc(ROOT):
        problems.append(f"a committed non-root .npmrc exists ({sub.relative_to(ROOT).as_posix()}) - pnpm "
                        "reads per-directory .npmrc, so only a single repo-root .npmrc may carry the pin "
                        "(G18c); move its settings to the root or remove it")

    # a committed .pnpmfile.cjs is arbitrary install-time code (a custom fetcher/resolver can re-source
    # any dependency while the recorded lockfile URL still reads npmjs.org, defeating the URL guard) -
    # it has no place in a zero-egress offline product; forbid it outright (G18c/G18d)
    for pf in PNPMFILE_CANDIDATES:
        if pf.is_file():
            problems.append(f"a committed {pf.name} exists - pnpm install-time custom fetcher/resolver "
                            "code can silently re-source dependencies (defeats the resolution-URL guard) "
                            "and runs in the secret-bearing CI job; forbidden in a zero-egress product")
    # the pnpm-workspace.yaml `registries:` map is the YAML analogue of the .npmrc registry pin
    ws_text = PNPM_WORKSPACE.read_text(encoding="utf-8") if PNPM_WORKSPACE.is_file() else ""
    if ws_text:
        problems += workspace_registries_problems(ws_text)
        problems += workspace_frozen_lockfile_problems(ws_text)
        problems += workspace_lifecycle_problems(ws_text)
        problems += workspace_env_problems(ws_text)

    # committed install-time source-mutation / code (patchedDependencies+patches, source-redirect
    # overrides, root install-lifecycle scripts) - the resolution-URL guard is blind to these
    pkg: dict = {}
    if PACKAGE_JSON.is_file():
        try:
            loaded = json.loads(PACKAGE_JSON.read_text(encoding="utf-8"))
            pkg = loaded if isinstance(loaded, dict) else {}
        except json.JSONDecodeError:
            problems.append("package.json is not valid JSON - fail-closed")
    problems += install_mutation_problems(pkg, ws_text, any(PATCHES_DIR.glob("*")) if PATCHES_DIR.is_dir() else False)

    manifest_present = PACKAGE_JSON.is_file() or PNPM_WORKSPACE.is_file()
    if PNPM_LOCK.is_file():
        problems += lockfile_url_problems(PNPM_LOCK.read_text(encoding="utf-8"))
    elif manifest_present:
        problems.append("a pnpm manifest exists but pnpm-lock.yaml is missing - the committed lockfile "
                        "must exist for the resolution-URL guard to run (G18a/G18c); never a silent skip")
    else:
        print("[G18c] no pnpm-lock.yaml yet (lands in P1) - skipping the resolution-URL guard "
              "(the .npmrc registry pin is enforced now); fail-closed the moment the lockfile exists")

    n = onlybuilt_count()
    if n is None:
        print("[G18d] no pnpm manifest yet (lands in P1) - skipping the onlyBuiltDependencies "
              "allowlist count (pnpm 10 blocks lifecycle scripts by default); fail-closed in P1")
    elif n >= _UNCOUNTABLE:
        problems.append("the pnpm build-script allowlist (onlyBuiltDependencies/allowBuilds) is present "
                        "but not in a form this guard can count - fail-closed (rewrite it as a plain "
                        "list, or extend the parser here with a Dual-Review note) (G18d)")
    elif n > EXPECTED_ONLYBUILT_COUNT:
        problems.append(f"onlyBuiltDependencies allowlist holds {n} entr(ies) > the frozen "
                        f"{EXPECTED_ONLYBUILT_COUNT} - a build-script allowlist growth must raise "
                        "EXPECTED_ONLYBUILT_COUNT here with a box-id + Dual-Review note (G18d)")

    problems += _pinned_floor_assertion()                # §0.8 JS pinned-floor (P1.60)

    if problems:
        for p in problems:
            fail(p)
        return 1
    if PNPM_LOCK.is_file():
        lock_state = "live"
        floor_state = f"{len(PINNED_FLOORS_JS)} §0.8 JS floor crate(s) >= floor"
    else:
        lock_state = "target-absent (no lockfile yet)"
        floor_state = "§0.8 floor skipped (no lockfile yet)"
    print(f"[G18c/d] JS supply-chain posture OK (registry pinned to {ALLOWED_HOST}, no scoped override; "
          f"pre/post-scripts + unsafe-perm off; no unlisted .npmrc key; no refused pnpm-workspace.yaml setting; "
          f"no committed frozen-lockfile (CI pin = the G18a flag-scan); "
          f"lockfile resolution-shape + URL + onlyBuiltDependencies checks {lock_state}; {floor_state})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
