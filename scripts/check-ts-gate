#!/usr/bin/env python3
"""check-ts-gate - G5/G6/G13 TypeScript / React lint / type-check / format / test contract (P0.4.7).
The TypeScript half of the build-quality plane (the Rust half is check-rust-lint-contract, P0.4.1).

Two tiers, the same pattern as the Rust contract (P0.4.1) and the supply-chain skeleton (P0.3.6):

  STRUCTURAL FREEZE (live NOW, no toolchain needed): the TS-gate CONTRACT cannot be silently gutted.
  The required `tsconfig.json` strict-family flags (TSCONFIG_REQUIRED), the eslint flat-config
  project-local rules the config MUST carry (ESLINT_REQUIRED_RULES — the no-`any` rule + the
  `fc.gen()`-shrink-wrapper rule paired with G9 invariant (f), P0.3.10), and the set of tool scripts
  the package manifest must wire (PKG_REQUIRED_SCRIPTS) are frozen here as non-empty contracts. A
  relaxation reddens the gate (and is an owner-acked L(-1) edit, G71).

  LIVE (per-tool, target-absent until each tool lands): once a frontend `package.json` exists, the
  CONDITIONAL content checks fire as their target appears — the `tsconfig.json` strict flags (G6/G13)
  once tsconfig lands, the eslint flat-config project-local rules (G5) once the flat config lands. The
  per-tool WIRING contract (assert_toolchain_wiring) then requires each tool's config presence and its
  package.json script to AGREE (a config with no runnable script, or a script with no config, is a
  half-wired tool); a tool with NEITHER has not landed yet and is tolerated. Then RUN `tsc --noEmit`
  (G6 changed-scope at L1 / G13 whole-project at L2), `eslint` + `stylelint` (G5), `prettier --check`
  (G5), and `vitest` — via the pinned pnpm toolchain (guarded: skipped with a notice if pnpm/node is not
  installed, exactly as the Rust contract skips when cargo is absent). The manifest lands in P1.2 but the
  toolchain configs+scripts land STAGGERED across P1.30/P1.33/P1.34/P1.35 (each box wiring its config +
  script together), so a bare manifest no longer arms the whole contract at once — the prior
  package.json-arms-everything posture wrongly demanded the P1.30–P1.35 configs already at P1.2.

  T2 SINK BAN (security-concept §5 T2, the primary T2 sink control; build-gates G5): eslint.config.mjs
  bans by name the DOM and eval sinks, the APIs that parse a string as unsanitized markup or as code.
  STRUCTURAL (assert_eslint_sink_ban): each ESLINT_SINK_RULES rule is declared exactly once, at "error"
  — a flat config replaces a rule's options and severity in a later matching block, so a second,
  files-scoped declaration could lift a ban for some files — and `noInlineConfig: true` keeps an inline
  directive from lifting one. LIVE (the pnpm toolchain present): the ARMED CANARY (run_sink_canary)
  lints the planted fixture SINK_FIXTURE from stdin as SINK_PROBE_AS BEFORE the real run and fails
  unless every `eslint-must-fire` pin reports its rule at error severity, so a ban dropped, downgraded or
  narrowed in the config — or an eslint/plugin bump that loosens a rule — reds the gate even on a clean
  tree (the check-sast prelude discipline). The canary proves the bans at one path, so the SCOPE leg
  (run_sink_scope) carries that proof to every src/ source file: eslint's own per-file resolution
  (ESLint#calculateConfigForFile — the config file nearest the file, then each block's files, ignores and
  basePath) must give each file what it gives SINK_PROBE_AS for the sink rules to read — the same
  ESLINT_SINK_RULES entries (severity and options), language, language options (the parser and its
  options, the ECMAScript version, the source type, the globals a rule resolves a name against) and shared
  settings, noInlineConfig on and no processor — so no narrowed block, nested config file, or scoped linter
  or language options lift a ban for part of src/. The REAL RUN (run_eslint_tree) then fails on any
  message, a warning included, and on a src/ source file eslint did not lint (an `ignores` entry or an
  extension no config block lints), so no WebView file escapes the ban.

WHY contract-only (no config files authored here): spec §0.7 homes `tsconfig.json` / `package.json` /
`vite.config.ts` in the P1 FRONTEND BUILD, and the eslint/vitest configs import the (P1-installed)
toolchain — so, unlike the Rust contract's standalone `rustfmt.toml`/`clippy.toml`, the TS config FILES
land coherently in P1 (P1.29/P1.35/P1.64) and this gate freezes the CONTRACT they must satisfy. This
mirrors P0.4.2 (which froze the unsafe/SAST contract but authored no crate roots).
[Build-Session-Entscheidung: P0.4.7]

The JS supply-chain config the P1 `pnpm install` honours (the `.npmrc` registry pin + lifecycle
lockdown) is P0.3.8's check-js-supply-chain — this gate consumes that posture (it does not re-assert it).

stdlib-only. L(-1) security-critical (matched by scripts/**).

Usage: check-ts-gate [--full]   (--full = the G13 whole-project tsc + the whole-tree lint leg, L2/push)
Exit:  0 = contract intact (or target-absent); 1 = a violation; 2 = a required config is missing/malformed.
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path
for _stream in (sys.stdout, sys.stderr):          # the console's codepage is not this script's concern (G9 invariant i)
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(encoding="utf-8", errors="replace")

ROOT = Path(__file__).resolve().parents[1]

# --- the frozen TS-gate CONTRACT (a relaxation here = an enforcement-plane weakening, owner-acked) ----
# tsconfig.json compilerOptions that MUST be set true once tsconfig lands (G6/G13). `strict` is the
# umbrella (the CLAUDE.md "no `any`" + spec §0.8 "TypeScript strict"); the three explicit extras are the
# high-value flags `strict` does NOT imply: noUncheckedIndexedAccess (an array/record index yields
# `T | undefined` — the TS analogue of the Rust `indexing_slicing` deny on untrusted data, so an
# out-of-bounds read cannot be typed as defined), noImplicitOverride, and noFallthroughCasesInSwitch.
TSCONFIG_REQUIRED = {
    "strict": True,
    "noUncheckedIndexedAccess": True,
    "noImplicitOverride": True,
    "noFallthroughCasesInSwitch": True,
}
# The eslint FLAT config (eslint.config.{js,mjs,cjs,ts}) MUST carry these project-local rule markers —
# asserted by a delimiter-bounded text scan (a flat config is JS, not statically parseable with stdlib,
# so we assert the rule TOKEN is present and NOT switched off to "off"/0). Each is a load-bearing rule:
#   - the no-`any` rule (@typescript-eslint/no-explicit-any) — the CLAUDE.md hard rule + §0.4.5 (the
#     generated bindings.ts is the only IPC door, no `any` at the boundary);
#   - the fc.gen()-shrink-wrapper ban — `fc.gen(` outside the approved wrapper defeats property-test
#     shrinking; G9 invariant (f) greps for it too (belt-and-suspenders), but the box pairs it with an
#     eslint rule here (a no-restricted-syntax / no-restricted-properties rule naming `fc` `gen`).
ESLINT_REQUIRED_RULES = [
    ("no-explicit-any (CLAUDE.md no-`any` / §0.4.5 IPC boundary)", "@typescript-eslint/no-explicit-any"),
    ("fc.gen() shrink-wrapper ban (paired with G9 invariant (f), P0.3.10)", "fc.gen"),
]
# §5.1 / G5 single-IPC-consumer import-ban tokens the flat config MUST carry (frozen present, cage
# option B — the JS lint-plane config is NOT in the L(-1) cage like its Rust peers rustfmt/clippy, so
# WITHOUT this freeze the autonomous Build-Loop could silently delete the tauri IPC-surface ban in a
# routine commit and the live `eslint .` run would stay green with no violation to catch). Presence in a
# NON-comment position is the freeze: dropping the ban removes the token → FAIL. The live eslint run is
# the real per-file enforcement; this guarantees the ban EXISTS in the committed config (P2.106 Co-Pilot).
ESLINT_REQUIRED_IMPORT_BANS = [
    ("the §5.1 @tauri-apps/api single-IPC-consumer ban (P1.36)", "@tauri-apps/api"),
    ("the §5.1 @tauri-apps/plugin-* single-IPC-consumer ban (P2.95)", "@tauri-apps/plugin-*"),
]
# The T2 DOM/eval sink ban (security-concept §5 T2): the rules eslint.config.mjs must declare EXACTLY ONCE,
# at "error". Once, because a flat config REPLACES a rule's options and severity in a later matching block:
# a second, files-scoped declaration could re-declare a rule with fewer banned names, or at a lower
# severity, for part of src/ while the first stays intact. The canary proves each rule fires on its pinned
# sinks at one path; the scope leg proves every src/ file's evaluated config carries the same entries (the
# text freeze below also holds where the live tier cannot run).
ESLINT_SINK_RULES = [
    "no-restricted-properties",            # the sink properties (the timers off window and globalThis)
    "no-restricted-syntax",                # the shapes a property ban cannot see (and the fc.gen ban)
    "no-restricted-globals",               # the global Function referenced bare, an alias included
    "no-eval",                             # direct and indirect eval
    "no-implied-eval",                     # a global timer given a string constant or a string literal or template
    "@typescript-eslint/no-implied-eval",  # a non-function-typed timer handler, in the forms eslint.config.mjs names
    "no-new-func",                         # the Function constructor called, constructed or applied
    "no-script-url",                       # a string or expression-free template starting javascript:
    "react/no-danger",                     # dangerouslySetInnerHTML, on every component
    "react/no-danger-with-children",
]
# The floor freeze_contract holds: the rules that ban the sinks the G29 rule-(i) Semgrep taint rule lists
# (innerHTML / outerHTML / insertAdjacentHTML / document.write / writeln, eval, Function, React's __html
# object) — the minimum the owner decision for T2 requires.
_RULE_I_SINK_FLOOR = frozenset({"no-restricted-properties", "no-restricted-syntax", "no-eval", "no-new-func",
                                "react/no-danger"})
# The planted-positive fixture the armed canary lints (eslint.config.mjs ignores scripts/, so the real run
# never sees it) and the path it is linted AS: the WebView entry (spec §0.7 load-bearing), so the src/
# blocks and the type-aware project service apply to it exactly as to the real source. The stdin text
# stands in for that file in eslint's view only; the probe never writes the file on disk.
SINK_FIXTURE = "scripts/gate-selftests/eslint-sink-fixture.tsx"
SINK_PROBE_AS = "src/main.tsx"
# A fixture line ending in `// eslint-must-fire: <rule-id>[, <rule-id>...]` pins that line: each named rule
# must report there at error severity (the check-sast `sast-must-fire` pin, for eslint).
_FIRE_MARK_RE = re.compile(r"//\s*eslint-must-fire:\s*([A-Za-z0-9_@/,\s-]+?)\s*$")
# The WebView source the scope leg and the real run cover: every file under src/ with a JS-family extension
# except a declaration file, which carries no code (eslint.config.mjs ignores **/*.d.ts).
_SRC_EXTS = (".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs")
_DECLARATION_SUFFIXES = (".d.ts", ".d.mts", ".d.cts")
# The scope leg's probe, a Node program read from stdin (`node --input-type=module -`, so no helper file
# exists; module resolution starts at the repo root, the gate's cwd). For each input file it asks eslint
# for the evaluated config (ESLint#calculateConfigForFile, the per-file lookup `eslint .` itself uses) and
# prints {file: null} for a file eslint ignores, else the ESLINT_SINK_RULES entries as eslint normalizes
# them ([severity, ...options], null when absent), linterOptions.noInlineConfig, whether a processor
# rewrites the text before the rules read it, and a `context` map of the other evaluated inputs a rule
# reads: the language and the parser by object identity (one token per object, so another object never
# compares equal), the settings and every other language option by value (a sha256 of key-sorted JSON in
# which a function is its identity token). @INPUT@ becomes the JSON {"files": [...], "rules": [...]}.
_SINK_SCOPE_JS = """\
const input = @INPUT@;
const { ESLint } = await import("eslint");
const { createHash } = await import("node:crypto");
const eslint = new ESLint();
const ids = new Map();
const identity = (value) => {
  if (!ids.has(value)) ids.set(value, `object#${ids.size}`);
  return ids.get(value);
};
const canonical = (value) =>
  JSON.stringify(value ?? null, (key, v) =>
    typeof v === "function"
      ? identity(v)
      : v !== null && typeof v === "object" && !Array.isArray(v)
        ? Object.fromEntries(Object.keys(v).sort().map((name) => [name, v[name]]))
        : v,
  );
const digest = (value) => createHash("sha256").update(canonical(value)).digest("hex");
const out = {};
for (const file of input.files) {
  const config = await eslint.calculateConfigForFile(file);
  out[file] = config === undefined ? null : {
    rules: Object.fromEntries(input.rules.map((rule) => [rule, config.rules?.[rule] ?? null])),
    noInlineConfig: config.linterOptions?.noInlineConfig ?? null,
    processor: config.processor !== undefined,
    context: Object.fromEntries([
      ["language", identity(config.language)],
      ["settings", digest(config.settings)],
      ...Object.entries(config.languageOptions ?? {}).map(([key, value]) => [
        `languageOptions.${key}`,
        key === "parser" ? identity(value) : digest(value),
      ]),
    ]),
  };
}
process.stdout.write(JSON.stringify(out));
"""
# The context entries the reference must carry (the five language options eslint evaluates for JavaScript,
# the language and the settings); a probe output without one of them fails closed. Every other file must
# carry the reference's context entries exactly, an extra entry included.
_SINK_SCOPE_CONTEXT = ("language", "settings", "languageOptions.ecmaVersion", "languageOptions.sourceType",
                       "languageOptions.parser", "languageOptions.parserOptions", "languageOptions.globals")
# package.json scripts the manifest MUST wire (so L4 CI + a contributor can run each gate). Matched as a
# tool TOKEN appearing in the scripts block (e.g. a `tsc` script, an `eslint` script).
PKG_REQUIRED_SCRIPTS = ["tsc", "eslint", "prettier", "vitest"]

# candidate config locations (P1 authors exactly one of each; a presence check, the deep correctness is
# the live tool run + the P1 G1 dual-review). vitest config may live in its own file OR in vite.config.
_ESLINT_FLAT = ["eslint.config.js", "eslint.config.mjs", "eslint.config.cjs", "eslint.config.ts"]
_PRETTIER = [".prettierrc", ".prettierrc.json", ".prettierrc.cjs", ".prettierrc.js", ".prettierrc.mjs",
             ".prettierrc.yaml", ".prettierrc.yml", "prettier.config.js", "prettier.config.cjs",
             "prettier.config.mjs"]
_STYLELINT = [".stylelintrc", ".stylelintrc.json", ".stylelintrc.cjs", ".stylelintrc.js",
              "stylelint.config.js", "stylelint.config.cjs", "stylelint.config.mjs"]
_VITEST = ["vitest.config.ts", "vitest.config.js", "vitest.config.mjs"]
_VITE = ["vite.config.ts", "vite.config.js", "vite.config.mjs"]


def fail(msg: str) -> None:
    print(f"[G5/G6/G13] FAIL: {msg}", file=sys.stderr)


def freeze_contract() -> int:
    """The contract constants must stay non-empty + well-formed — they cannot be silently gutted to an
    empty policy (the same `freeze_contract` discipline as the Rust contract's REQUIRED_ATTRS)."""
    problems = 0
    if not TSCONFIG_REQUIRED or "strict" not in TSCONFIG_REQUIRED:
        fail("TSCONFIG_REQUIRED is empty or dropped `strict` — the type-strictness policy is gone")
        problems += 1
    if not ESLINT_REQUIRED_RULES or not any("no-explicit-any" in tok for _, tok in ESLINT_REQUIRED_RULES):
        fail("ESLINT_REQUIRED_RULES is empty or dropped no-explicit-any — the no-`any` policy is gone")
        problems += 1
    if not any("fc.gen" in tok for _, tok in ESLINT_REQUIRED_RULES):
        fail("ESLINT_REQUIRED_RULES dropped the fc.gen ban — the shrink-wrapper policy (the G9 "
             "invariant (f) pair) is gone (both named rules are guarded symmetrically per the docstring)")
        problems += 1
    if not any("@tauri-apps/api" in tok for _, tok in ESLINT_REQUIRED_IMPORT_BANS) or not any(
            "@tauri-apps/plugin-*" in tok for _, tok in ESLINT_REQUIRED_IMPORT_BANS):
        fail("ESLINT_REQUIRED_IMPORT_BANS dropped a §5.1 single-IPC-consumer ban token (@tauri-apps/api "
             "and @tauri-apps/plugin-* are both required) — the cage-B freeze of the IPC-surface ban is gone")
        problems += 1
    if not _RULE_I_SINK_FLOOR <= set(ESLINT_SINK_RULES):
        fail("ESLINT_SINK_RULES dropped a rule that bans a G29 rule-(i) sink (needs "
             f"{sorted(_RULE_I_SINK_FLOOR)}) — the T2 sink-ban freeze is gutted")
        problems += 1
    if not SINK_FIXTURE or not SINK_PROBE_AS:
        fail("SINK_FIXTURE / SINK_PROBE_AS is empty — the T2 sink-ban armed canary has nothing to lint")
        problems += 1
    if not PKG_REQUIRED_SCRIPTS:
        fail("PKG_REQUIRED_SCRIPTS is empty — the tool-wiring contract is gone")
        problems += 1
    if any(t not in _TOOL_CONFIG for t in PKG_REQUIRED_SCRIPTS):
        fail("a PKG_REQUIRED_SCRIPTS tool lacks a _TOOL_CONFIG detector — the per-tool config/script "
             "agreement check (assert_toolchain_wiring) would crash on it (contract/detector drift)")
        problems += 1
    return problems


def _frontend_manifest() -> Path | None:
    """The first-party frontend package.json (the P1 target). v1 is a single front-end package, so the
    root package.json is the manifest; a future multi-package workspace subdir is the P1 refinement."""
    cand = ROOT / "package.json"
    return cand if cand.is_file() else None


def _read_jsonc(path: Path):
    """Parse a tsconfig.json (JSONC: // + /* */ comments + trailing commas allowed). Strings are
    protected first, so a `//` or `/*` inside a "…" value is not mis-stripped, then comments are blanked
    and trailing commas removed, then stdlib json.loads. Returns (obj, None) or (None, error)."""
    try:
        raw = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        return None, f"unreadable ({e})"
    # protect string literals (so // or /* inside a value survives), blank comments, restore strings
    strings: list[str] = []

    def _stash(m: "re.Match[str]") -> str:
        strings.append(m.group(0))
        return f"\x00{len(strings) - 1}\x00"

    protected = re.sub(r'"(?:\\.|[^"\\])*"', _stash, raw)
    protected = re.sub(r"/\*.*?\*/", " ", protected, flags=re.S)        # block comments
    protected = "\n".join(re.sub(r"//.*$", "", ln) for ln in protected.split("\n"))  # line comments
    protected = re.sub(r",(\s*[}\]])", r"\1", protected)                # trailing commas
    restored = re.sub(r"\x00(\d+)\x00", lambda m: strings[int(m.group(1))], protected)
    try:
        return json.loads(restored), None
    except (json.JSONDecodeError, ValueError) as e:
        return None, f"malformed ({e})"


def _tsconfig_options(path: Path, _seen: set | None = None) -> tuple[dict, str | None]:
    """The effective compilerOptions of a tsconfig, following the local-file `extends` CHAIN (MULTI-level,
    cycle-guarded by `_seen`) AND the TS5 `extends` ARRAY form (`["./a.json", "./b.json"]` — later entries
    override earlier), so a strict flag set in a committed base (or grandparent base) is not a
    false-negative (P0.4.7 G1 P2/P3). The one residual is a NON-local (npm-package / out-of-repo)
    `extends` (e.g. `@tsconfig/strictest`), which cannot be read at gate time — it leaves the inherited
    flags unverified and so reports them missing (over-strict / fail-CLOSED, never fail-open); resolving a
    package extends from node_modules is the recorded P1 refinement. Returns (options, error)."""
    _seen = _seen or set()
    if str(path) in _seen:                              # cycle guard (a base that extends back)
        return {}, None
    _seen.add(str(path))
    obj, err = _read_jsonc(path)
    if err is not None:
        return {}, err
    if not isinstance(obj, dict):
        return {}, "top-level is not an object"
    opts: dict = {}
    ext = obj.get("extends")
    ext_list = ext if isinstance(ext, list) else ([ext] if isinstance(ext, str) else [])
    for e in ext_list:                                  # local bases first (later overrides earlier, TS5)
        if isinstance(e, str) and e.startswith("."):
            base = (path.parent / e).resolve()
            if base.suffix != ".json":
                base = base.with_suffix(".json")
            if base.is_file():
                base_opts, _ = _tsconfig_options(base, _seen)
                opts.update(base_opts)
    co = obj.get("compilerOptions")
    if isinstance(co, dict):
        opts.update(co)
    return opts, None


def assert_tsconfig_strict() -> int:
    """P1: once tsconfig.json lands, assert each TSCONFIG_REQUIRED flag is set to its required value in
    the effective compilerOptions (G6/G13). Target-absent until tsconfig.json exists."""
    tsconfig = ROOT / "tsconfig.json"
    if not tsconfig.is_file():
        return 0                                       # tsconfig lands in P1 — target-absent
    opts, err = _tsconfig_options(tsconfig)
    if err is not None:
        fail(f"tsconfig.json is {err} — the strict policy cannot be verified")
        return 2
    problems = 0
    for key, want in TSCONFIG_REQUIRED.items():
        if opts.get(key) != want:
            fail(f"tsconfig.json compilerOptions.{key} is {opts.get(key)!r}, must be {want!r} "
                 f"(a relaxation of the frozen strict policy)")
            problems += 1
    return problems


def _eslint_config() -> Path | None:
    for name in _ESLINT_FLAT:
        if (ROOT / name).is_file():
            return ROOT / name
    return None


def _strip_js_comments(text: str) -> str:
    """Blank `//` and `/* */` comments while KEEPING string/template literals — so the eslint RULE NAME
    (itself a string key, e.g. "@typescript-eslint/no-explicit-any") stays visible to the presence +
    off-detection scans, while a commented-out rule line is correctly dropped.

    SINGLE-PASS scanner (strings AND comments recognized in ONE left-to-right walk): a quote INSIDE a
    comment never opens a string, and a `//`/`/*` INSIDE a string never starts a comment. This replaces a
    prior strings-FIRST regex that a lone apostrophe in a comment (a routine possessive/contraction, e.g.
    ``the plugin's error()``) tripped — the unbalanced `'` opened a phantom cross-line single-quote span
    (`re.S`) that stashed real rule-token text, so the presence scan wrongly reported both required rules
    missing (P2.106 G1 Opus P0; the same fragility class fixed in check-repo-invariants). Comments collapse
    to one space (a token boundary); strings are kept verbatim (with `\\` escapes honoured).

    LIMITATION — regex literals (HONEST residual, G1 Opus P2): a JS regex literal `/.../ ` is treated as
    DIVISION, not a literal (regex-vs-division needs a full parse). This holds because an eslint flat config
    uses STRING selectors and has NO regex literals — verified for the real `eslint.config.mjs`. Were a regex
    literal containing a quote ever added (e.g. `/it's/`), that `'` WOULD open a phantom string span that
    could swallow a FOLLOWING comment, keeping its tokens — a fail-open the live `eslint .` run does NOT
    backstop (a regex-vs-string mislex, not a rule violation). It is not reachable by a routine config edit
    (a ban deletion removes the tokens entirely → caught) and adding a regex literal is itself a reviewable
    change; making the scanner fully regex-aware is out of proportion, so this is documented, not closed."""
    out: list[str] = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c in "\"'`":                                    # string / template literal — keep verbatim
            quote = c
            out.append(c)
            i += 1
            while i < n:
                d = text[i]
                out.append(d)
                if d == "\\" and i + 1 < n:                # escape: the next char is literal, never a close
                    out.append(text[i + 1])
                    i += 2
                    continue
                i += 1
                if d == quote:
                    break
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":  # line comment → one space, keep the newline
            i += 2
            while i < n and text[i] != "\n":
                i += 1
            out.append(" ")
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":  # block comment → one space
            i += 2
            while i < n and not (text[i] == "*" and i + 1 < n and text[i + 1] == "/"):
                i += 1
            i += 2                                         # consume the closing */ (past EOF if unterminated)
            out.append(" ")
            continue
        out.append(c)
        i += 1
    return "".join(out)


# a rule severity switched OFF immediately after the rule key: `: "off"` / `: 'off'` / `: 0` / `: ["off"`.
# `\b` is anchored to the bare `0` only (so `0` ≠ `0xFF`) — the quoted forms end in `"`/`'` (a non-word
# char), where a trailing `\b` would never hold.
_OFF_RE = re.compile(r""":\s*\[?\s*(?:"off"|'off'|0\b)""")


def _rule_is_off(text: str, token: str) -> bool:
    """True iff the rule `token` is set to an OFF/0 severity. Scans from EACH occurrence of the token
    ACROSS newlines up to the start of the NEXT rule key (`, "…"`) or a 200-char bound — so a
    formatter-wrapped MULTI-line `"rule":\n["off"]` IS caught (the prior per-physical-line scan missed it,
    P0.4.7 G1 P2), while an unrelated `: 0` / `["off"]` belonging to a DIFFERENT key sharing the same
    physical line does NOT cross-contaminate (the window stops before the next key, P0.4.7 G1 P2)."""
    for mt in re.finditer(re.escape(token), text):
        win = text[mt.end():mt.end() + 200]            # this rule's value, spanning newlines
        cut = re.search(r""",\s*["']""", win)          # stop before the next rule key's value
        if cut:
            win = win[:cut.start()]
        if _OFF_RE.search(win):
            return True
    return False


def assert_eslint_rules() -> int:
    """P1: once the eslint flat config lands, assert each ESLINT_REQUIRED_RULES token is PRESENT in a
    NON-comment position and not switched OFF (G5). A flat config is JS (not stdlib-parseable), so this
    scans the COMMENT-stripped (strings-KEPT) text — the rule name is itself a string key, so it must
    stay visible — for the rule token (it must appear at all) and for an off/0 severity on its line.
    Over-strict (flags a rule it cannot fully prove is ON) is SAFE; the live eslint run is the real
    enforcement, this freeze guarantees the RULE EXISTS + is not trivially disabled in the committed
    config (and G9 invariant (f) is the belt-and-suspenders grep for the fc.gen case)."""
    cfg = _eslint_config()
    if cfg is None:
        return 0                                       # eslint flat config lands in P1 — target-absent
    text = _strip_js_comments(cfg.read_text(encoding="utf-8", errors="replace"))
    problems = 0
    for desc, token in ESLINT_REQUIRED_RULES:
        if token not in text:                          # the rule token must appear (outside comments)
            fail(f"eslint flat config {cfg.name} is missing the required rule {desc} (token {token!r})")
            problems += 1
            continue
        if _rule_is_off(text, token):                  # token-proximity scan (multi-line + no cross-contam)
            fail(f"eslint flat config {cfg.name}: rule {desc} ({token!r}) appears switched OFF")
            problems += 1
    for desc, token in ESLINT_REQUIRED_IMPORT_BANS:    # §5.1 single-IPC-consumer ban tokens (frozen present)
        # QUOTE-DELIMITED match, NOT a bare substring: the ban's own human-readable `message:` string
        # legitimately NAMES the banned packages (e.g. "…may import the Tauri IPC surface (@tauri-apps/api or
        # a @tauri-apps/plugin-* package)…"), so `token in text` would find the token in the MESSAGE even
        # after the functional `group: [...]` array is gutted — a fail-open (G1 Sonnet P0). Requiring the
        # token as its OWN quoted array element (`"<token>"` / `'<token>'`, matched quotes) hits the group
        # entry but NOT the message embed. Precise residual (G1 Sonnet R2): the match is file-WIDE, not
        # scoped to the `no-restricted-imports` group — so it guarantees a QUOTED occurrence of the token
        # exists in non-comment text, which a purposeless decoy (`const x = "@tauri-apps/api"`) could also
        # satisfy; but that is a conspicuous, functionally-pointless review diff (unlike the free message
        # collision this closes), and the live `eslint .` run is the real per-file enforcement.
        if not re.search(r'''(["'])''' + re.escape(token) + r'\1', text):
            fail(f"eslint flat config {cfg.name} dropped {desc} (no quoted \"{token}\" ban element) — the "
                 f"§5.1 single-IPC-consumer import ban must stay in the committed config")
            problems += 1
    return problems


# The value right after a rule key must be the error severity: "error", 'error' or 2, bare or as the first
# element of an options array. Any other value — "warn", "off", 0, 1, a variable — is a finding (fail-closed:
# a severity the scan cannot read is not proven to be an error).
_ERROR_SEVERITY_RE = re.compile(r"""\s*:\s*\[?\s*(?:"error"|'error'|2(?![\w.]))""")
_NO_INLINE_CONFIG_KEY_RE = re.compile(r"\bnoInlineConfig\b")
_NO_INLINE_CONFIG_TRUE_RE = re.compile(r"""\bnoInlineConfig["']?\s*:\s*true\b""")


def _quoted_hits(text: str, token: str) -> list["re.Match[str]"]:
    """Every occurrence of `token` as a whole quoted string — "tok" or 'tok', matched quotes — so
    "no-implied-eval" never counts inside "@typescript-eslint/no-implied-eval"."""
    return list(re.finditer(r"""(["'])""" + re.escape(token) + r"\1", text))


def assert_eslint_sink_ban() -> int:
    """The T2 sink-ban freeze (G5): once the eslint flat config lands, each ESLINT_SINK_RULES rule appears
    as a quoted key EXACTLY ONCE in non-comment text and its value starts with the error severity, and
    `noInlineConfig` appears exactly once, set `true`. Read over the comment-stripped (strings-kept) text,
    like assert_eslint_rules, so it holds where the live tier cannot run. The text is not the evaluated
    config (a computed key or a spread from another module escapes this scan); the live tier reads the
    evaluated one: the armed canary at SINK_PROBE_AS, the scope leg for every src/ source file."""
    cfg = _eslint_config()
    if cfg is None:
        return 0                                       # eslint flat config lands in P1 — target-absent
    text = _strip_js_comments(cfg.read_text(encoding="utf-8", errors="replace"))
    problems = 0
    for rule in ESLINT_SINK_RULES:
        hits = _quoted_hits(text, rule)
        if len(hits) != 1:
            fail(f"eslint flat config {cfg.name}: the T2 sink rule {rule!r} is declared {len(hits)} times — "
                 f"it must be declared exactly once (a second declaration replaces its options or severity "
                 f"for the files it matches)")
            problems += 1
        elif not _ERROR_SEVERITY_RE.match(text, hits[0].end()):
            fail(f"eslint flat config {cfg.name}: the T2 sink rule {rule!r} is not set to \"error\" — a "
                 f"ban must fail eslint itself, where a warning passes")
            problems += 1
    if len(_NO_INLINE_CONFIG_KEY_RE.findall(text)) != 1 or not _NO_INLINE_CONFIG_TRUE_RE.search(text):
        fail(f"eslint flat config {cfg.name}: `noInlineConfig: true` must appear exactly once — without it "
             f"an inline eslint-disable directive lifts a T2 sink ban")
        problems += 1
    return problems


def _present(cands: list[str]) -> bool:
    return any((ROOT / c).is_file() for c in cands)


def _vitest_config_present() -> bool:
    """A vitest config: its own `vitest.config.*` OR a `test:` block inside a `vite.config.*`."""
    return _present(_VITEST) or any(
        (ROOT / v).is_file()
        and re.search(r"(?m)^\s*test\s*:", (ROOT / v).read_text(encoding="utf-8", errors="replace"))
        for v in _VITE)


# Per-script-tool config detector: its PRESENCE is coupled to the manifest script wiring by
# assert_toolchain_wiring. (The CONTENT of the tsc / eslint configs is separately frozen by
# assert_tsconfig_strict / assert_eslint_rules; here we only detect presence for the agreement check.)
_TOOL_CONFIG = {
    "tsc": lambda: (ROOT / "tsconfig.json").is_file(),
    "eslint": lambda: _eslint_config() is not None,
    "prettier": lambda: _present(_PRETTIER),
    "vitest": _vitest_config_present,
}


def _script_wired(tool: str, blob: str) -> bool:
    """True iff the tool token appears (whole-token) anywhere in the package.json scripts-block values."""
    return bool(re.search(r"(?<![\w-])" + re.escape(tool) + r"(?![\w-])", blob))


def assert_toolchain_wiring(manifest: Path) -> int:
    """P1: the per-tool frontend toolchain-wiring contract. Each PKG_REQUIRED_SCRIPTS tool's CONFIG
    presence and its package.json SCRIPT wiring must AGREE: a config with no runnable script, or a script
    with no config, is a half-wired tool (a violation, G5/G6/G13). A tool with NEITHER has not landed yet
    (target-absent, TOLERATED). This is the per-tool extension of the assert_tsconfig_strict /
    assert_eslint_rules tolerance: the manifest lands in P1.2 but the toolchain configs+scripts land
    STAGGERED (P1.30 tsc / P1.33 eslint+stylelint / P1.34 prettier / P1.35 vitest), each box wiring its
    config + script together, so a bare P1.2 manifest must not arm the whole contract at once. The
    stylelint config has no script token of its own in the contract; it lands WITH the eslint flat config
    (P1.33), so its presence is coupled to eslint's. [Build-Session-Entscheidung: P0.4.7]"""
    try:
        pkg = json.loads(manifest.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError, UnicodeDecodeError, ValueError) as e:
        fail(f"package.json is malformed/unreadable ({e})")
        return 2
    scripts = pkg.get("scripts", {})
    if not isinstance(scripts, dict):
        fail("package.json `scripts` is not an object")
        return 1
    blob = " ".join(str(v) for v in scripts.values())
    problems = 0
    for tool in PKG_REQUIRED_SCRIPTS:
        has_config = _TOOL_CONFIG[tool]()
        has_script = _script_wired(tool, blob)
        if has_config and not has_script:
            fail(f"{tool!r} config is present but package.json scripts do not wire it "
                 f"(a half-wired toolchain; the G5/G6/G13 tool is not runnable)")
            problems += 1
        elif has_script and not has_config:
            fail(f"package.json wires a {tool!r} script but its config is absent "
                 f"(a half-wired toolchain; a script with no config)")
            problems += 1
        # NEITHER: the tool has not landed yet (target-absent, tolerated). BOTH: wired correctly.
    # stylelint: coupled to the eslint flat config (they land together in P1.33).
    if _eslint_config() is not None and not _present(_STYLELINT):
        fail("eslint flat config is present but no stylelint config found "
             "(the G5 CSS-lint contract is unwired; stylelint lands with eslint in P1.33)")
        problems += 1
    return problems


def _run(label: str, argv: list[str]) -> int:
    # Resolve argv[0] via shutil.which so a Windows `.CMD`/`.BAT` shim (corepack's `pnpm.CMD`) is found and
    # runnable by full path — a bare list-form `subprocess.run(["pnpm", ...])` on Windows cannot exec a
    # `.CMD` (CreateProcess needs the resolved path). On POSIX this is a no-op (pnpm is a real binary). Mirrors _have.
    exe = shutil.which(argv[0])
    if exe is None:
        fail(f"{label}: cannot invoke {argv[0]} — the pinned toolchain/tool is not on PATH")
        return 1
    try:
        r = subprocess.run([exe, *argv[1:]], cwd=str(ROOT))
    except OSError as e:
        fail(f"{label}: cannot invoke {argv[0]} ({e}) — the pinned toolchain/tool is not installed")
        return 1
    if r.returncode != 0:
        fail(f"{label}: `{' '.join(argv)}` exited {r.returncode}")
        return 1
    return 0


def _have(tool: str) -> bool:
    # shutil.which resolves PATHEXT (Windows `.CMD`/`.BAT` shims like the corepack `pnpm.CMD`), which a bare
    # `subprocess.run([tool, "--version"])` does NOT — without this the gate FALSELY reports "pnpm not
    # installed" and skips the live tier on a Windows dev box where pnpm IS present (a green-but-blind skip).
    return shutil.which(tool) is not None


def _eslint_json(args: list[str], stdin: str | None = None) -> tuple[list | None, str]:
    """Run `pnpm exec eslint <args> --format json` at the repo root and return (results, "") — the parsed
    result list — or (None, why) when eslint did not produce one: not invocable, an exit other than 0
    (clean) and 1 (lint findings), or output that is not a JSON list."""
    exe = shutil.which("pnpm")
    if exe is None:
        return None, "pnpm is not on PATH"
    try:
        # encoding=utf-8/replace: eslint emits UTF-8; the default Windows cp1252 reader would crash on it
        p = subprocess.run([exe, "exec", "eslint", *args, "--format", "json"], cwd=str(ROOT), input=stdin,
                           capture_output=True, encoding="utf-8", errors="replace")
    except OSError as e:
        return None, f"cannot invoke eslint ({e})"
    if p.returncode not in (0, 1):
        return None, f"eslint exited {p.returncode}: {(p.stderr or p.stdout or '').strip()[:400]}"
    try:
        data = json.loads(p.stdout)
    except json.JSONDecodeError:
        return None, f"eslint printed no JSON result list: {(p.stderr or p.stdout or '').strip()[:400]}"
    if not isinstance(data, list) or not all(isinstance(r, dict) for r in data):
        return None, "eslint's JSON output is not a list of file results"
    return data, ""


def _messages(results: list) -> list[dict]:
    """(pure) Every message dict across an eslint JSON result list."""
    return [m for r in results for m in (r.get("messages") or []) if isinstance(m, dict)]


def parse_must_fire(text: str) -> dict[int, set[str]]:
    """(pure) 1-based line -> the rule ids its `// eslint-must-fire:` marker pins."""
    out: dict[int, set[str]] = {}
    for i, ln in enumerate(text.split("\n"), start=1):
        m = _FIRE_MARK_RE.search(ln)
        if m:
            ids = {p.strip() for p in m.group(1).replace(",", " ").split() if p.strip()}
            if ids:
                out[i] = ids
    return out


def unfired_pins(messages: list[dict], pins: dict[int, set[str]]) -> list[tuple[int, str, str]]:
    """(pure) (line, rule id, why) for every pin whose rule did not report on its line at error severity (2):
    "not reported" when the rule is silent there, "reported below error severity" when it only warns."""
    worst: dict[tuple[int, str], int] = {}
    for m in messages:
        line, rule, sev = m.get("line"), m.get("ruleId"), m.get("severity")
        if isinstance(line, int) and isinstance(rule, str) and isinstance(sev, int):
            worst[(line, rule)] = max(worst.get((line, rule), 0), sev)
    out = []
    for line in sorted(pins):
        for rule in sorted(pins[line]):
            sev = worst.get((line, rule), 0)
            if sev != 2:
                out.append((line, rule, "not reported" if sev == 0 else "reported below error severity"))
    return out


def sink_canary_problems(results: list, pins: dict[int, set[str]]) -> list[str]:
    """(pure) The armed-canary verdict over the eslint JSON of the fixture lint: a fatal (parse) message, a
    contract rule the fixture pins on no line (its ban would go unproven), and every unfired pin."""
    problems: list[str] = []
    messages = _messages(results)
    for m in messages:
        if m.get("fatal"):
            problems.append(f"the fixture did not lint as {SINK_PROBE_AS}: line {m.get('line')}: "
                            f"{str(m.get('message', ''))[:300]}")
    pinned = set().union(*pins.values()) if pins else set()
    for rule in ESLINT_SINK_RULES:
        if rule not in pinned:
            problems.append(f"the fixture pins no line for the T2 sink rule {rule!r}, so its ban is unproven")
    for line, rule, why in unfired_pins(messages, pins):
        problems.append(f"{SINK_FIXTURE}:{line}: {rule} {why}")
    return problems


def run_sink_canary() -> int:
    """The T2 sink-ban ARMED CANARY (live tier): lint SINK_FIXTURE from stdin as SINK_PROBE_AS through the
    committed config and fail on any sink_canary_problems finding. Runs before the real run, so a ban the
    config no longer arms reds the gate even when the tree itself is clean."""
    fixture, probe = ROOT / SINK_FIXTURE, ROOT / SINK_PROBE_AS
    if not fixture.is_file():
        fail(f"T2 sink canary: the planted fixture {SINK_FIXTURE} is missing — the ban cannot be proven")
        return 1
    if not probe.is_file():
        fail(f"T2 sink canary: {SINK_PROBE_AS}, the path the fixture is linted as, is missing")
        return 1
    text = fixture.read_text(encoding="utf-8", errors="replace")
    results, why = _eslint_json(["--stdin", "--stdin-filename", SINK_PROBE_AS], stdin=text)
    if results is None:
        fail(f"T2 sink canary: {why}")
        return 1
    problems = sink_canary_problems(results, parse_must_fire(text))
    for p in problems:
        fail(f"T2 sink canary: {p}")
    if problems:
        return 1
    print(f"[G5] T2 sink canary: every eslint-must-fire pin of {SINK_FIXTURE} reported its rule at error "
          f"severity, linted as {SINK_PROBE_AS}", flush=True)
    return 0


def _repo_rel(path: str) -> str:
    """A repo-relative POSIX path for an eslint `filePath` (absolute, OS-native); a path outside ROOT, or
    one that cannot be resolved, is returned POSIX-as-is, so it never matches a src/ entry by accident."""
    p = Path(path)
    try:
        return p.resolve().relative_to(ROOT.resolve()).as_posix()
    except (ValueError, OSError):
        return p.as_posix()


def _src_sources() -> list[str]:
    """Every file under ROOT/src with a JS-family extension, declaration files aside, as sorted
    repo-relative POSIX paths: the WebView source the T2 sink ban must reach. An absent src/ yields none
    (the frontend is target-absent)."""
    src = ROOT / "src"
    if not src.is_dir():
        return []
    return [f.relative_to(ROOT).as_posix() for f in sorted(src.rglob("*"))
            if f.is_file() and f.name.endswith(_SRC_EXTS) and not f.name.endswith(_DECLARATION_SUFFIXES)]


def unlinted_sources(linted: set[str]) -> list[str]:
    """Every _src_sources() file not in `linted` (repo-relative POSIX paths) — a WebView source an
    `ignores` entry or an unlinted extension would keep outside the T2 sink ban."""
    return [rel for rel in _src_sources() if rel not in linted]


def _sink_scope_configs(files: list[str]) -> tuple[dict | None, str]:
    """Run the _SINK_SCOPE_JS probe over `files` through `pnpm exec node` at the repo root and return
    ({file: entry}, "") — or (None, why) when it produced no such mapping: not invocable, a non-zero exit
    (a config that does not load, or a language option the probe cannot serialize, included), or output
    that is not a JSON object of objects and nulls."""
    exe = shutil.which("pnpm")
    if exe is None:
        return None, "pnpm is not on PATH"
    program = _SINK_SCOPE_JS.replace("@INPUT@", json.dumps({"files": files, "rules": ESLINT_SINK_RULES}))
    try:
        # the program goes in on stdin, never as an argument: a Windows .CMD shim would re-parse one
        p = subprocess.run([exe, "exec", "node", "--input-type=module", "-"], cwd=str(ROOT), input=program,
                           capture_output=True, encoding="utf-8", errors="replace")
    except OSError as e:
        return None, f"cannot invoke node ({e})"
    if p.returncode != 0:
        return None, f"node exited {p.returncode}: {(p.stderr or p.stdout or '').strip()[:400]}"
    try:
        data = json.loads(p.stdout)
    except json.JSONDecodeError:
        return None, f"the config probe printed no JSON: {(p.stderr or p.stdout or '').strip()[:400]}"
    if not isinstance(data, dict) or not all(v is None or isinstance(v, dict) for v in data.values()):
        return None, "the config probe's output is not a file -> config mapping"
    return data, ""


def sink_scope_problems(configs: dict, files: list[str]) -> list[str]:
    """(pure) The scope verdict over the evaluated per-file configs. SINK_PROBE_AS's entry is the reference
    the canary proves: each ESLINT_SINK_RULES rule at error severity (2), every _SINK_SCOPE_CONTEXT entry,
    noInlineConfig true, no processor. Every file in `files` must carry exactly the reference's rule entries
    (severity and options) and context entries (language, language options, settings), noInlineConfig true
    and no processor; a file eslint ignores (null), a missing, extra or differing rule or context entry, a
    noInlineConfig other than true and a processor are each a finding, and so is a reference that is
    absent, unarmed or without its context."""
    ref = configs.get(SINK_PROBE_AS)
    if not isinstance(ref, dict) or not isinstance(ref.get("rules"), dict):
        return [f"no evaluated config for {SINK_PROBE_AS}, the path the canary proves, so no file can be "
                f"compared with it"]
    ref_rules = ref["rules"]
    ref_context = ref.get("context") if isinstance(ref.get("context"), dict) else {}
    problems = [f"{SINK_PROBE_AS}: the T2 sink rule {rule!r} is not at error severity in its evaluated config "
                f"({ref_rules.get(rule)!r})" for rule in ESLINT_SINK_RULES
                if not (isinstance(ref_rules.get(rule), list) and ref_rules[rule][:1] == [2])]
    absent = [key for key in _SINK_SCOPE_CONTEXT
              if not (isinstance(ref_context.get(key), str) and ref_context[key])]
    if absent:
        problems.append(f"{SINK_PROBE_AS}: the probe reports no evaluated {absent}, so no file's language, "
                        f"language options or settings can be compared with it")
    for rel in dict.fromkeys([SINK_PROBE_AS, *files]):     # the reference's own two flags are checked too
        cfg = configs.get(rel)
        if not isinstance(cfg, dict):
            problems.append(f"{rel}: eslint applies no config to it (an ignores entry, or no block matches "
                            f"it), so no T2 sink ban reaches it")
            continue
        rules = cfg.get("rules") if isinstance(cfg.get("rules"), dict) else {}
        differing = [rule for rule in ESLINT_SINK_RULES if rules.get(rule) != ref_rules.get(rule)]
        if differing:
            problems.append(f"{rel}: the T2 sink rules {differing} differ from {SINK_PROBE_AS}'s evaluated "
                            f"config, so the canary's proof does not reach this file")
        context = cfg.get("context") if isinstance(cfg.get("context"), dict) else {}
        drift = sorted(key for key in {*ref_context, *context} if context.get(key) != ref_context.get(key))
        if drift:
            problems.append(f"{rel}: its evaluated {drift} differ from {SINK_PROBE_AS}'s, so the sink rules read "
                            f"another language setup there and the canary's proof does not reach this file")
        if cfg.get("noInlineConfig") is not True:
            problems.append(f"{rel}: noInlineConfig is not on, so an inline directive can lift a T2 sink ban")
        if cfg.get("processor") is not False:
            problems.append(f"{rel}: a processor rewrites its text before the T2 sink rules read it")
    return problems


def run_sink_scope() -> int:
    """The T2 sink-ban SCOPE leg (live tier): every src/ source file must be linted under the evaluated sink
    rules, language, language options and settings of SINK_PROBE_AS, the path the armed canary proves
    (sink_scope_problems over the _SINK_SCOPE_JS probe). Fails closed when the probe produces no mapping."""
    files = _src_sources()
    configs, why = _sink_scope_configs(sorted(set(files) | {SINK_PROBE_AS}))
    if configs is None:
        fail(f"T2 sink scope: {why}")
        return 1
    problems = sink_scope_problems(configs, files)
    for p in problems:
        fail(f"T2 sink scope: {p}")
    if problems:
        return 1
    print(f"[G5] T2 sink scope: all {len(files)} src/ source files carry the evaluated sink rules, language, "
          f"language options and settings of {SINK_PROBE_AS}, noInlineConfig on, no processor", flush=True)
    return 0


def run_eslint_tree() -> int:
    """The G5 real run: `eslint .` through the JSON formatter. Any message fails the gate, a warning
    included (so an inline directive, which noInlineConfig turns into a warning, cannot pass), and so does
    a src/ source file eslint did not lint (unlinted_sources)."""
    results, why = _eslint_json(["."])
    if results is None:
        fail(f"G5 eslint: {why}")
        return 1
    problems = 0
    for r in results:
        rel = _repo_rel(str(r.get("filePath", "")))
        for m in r.get("messages") or []:
            if isinstance(m, dict):
                fail(f"G5 eslint: {rel}:{m.get('line')}:{m.get('column')} "
                     f"{m.get('ruleId') or '(no rule)'}: {m.get('message')}")
                problems += 1
    for rel in unlinted_sources({_repo_rel(str(r.get("filePath", ""))) for r in results}):
        fail(f"G5 eslint: {rel} is a WebView source eslint did not lint (an ignores entry or an extension "
             f"no config block lints) — every src/ file must carry the T2 sink ban")
        problems += 1
    if problems == 0:
        print(f"[G5] eslint: {len(results)} files linted, no message; every src/ source file linted", flush=True)
    return 1 if problems else 0


def run_live_tools(full: bool) -> int:
    """P1: the live type-check / lint / format / test invocations through the pinned pnpm toolchain,
    guarded behind a pnpm-present check (skipped with a notice if node/pnpm is not yet installed — the
    same posture as the Rust contract skipping when cargo is absent; the real runs happen in the P1 CI
    once `pnpm install` has populated node_modules)."""
    if not _have("pnpm"):
        print("[G5/G6/G13] pnpm not installed yet (the toolchain pin lands in P1) — live "
              "tsc/eslint/stylelint/prettier/vitest runs skipped (target-absent)")
        return 0
    problems = 0
    # G6 (changed-scope at L1) / G13 (whole-project at L2/push) — tsc --noEmit either way
    problems += _run("G6/G13 tsc --noEmit", ["pnpm", "exec", "tsc", "--noEmit"])
    # G5: the T2 sink-ban armed canary first, then its scope over src/, then the real run
    problems += run_sink_canary()
    problems += run_sink_scope()
    problems += run_eslint_tree()
    problems += _run("G5 stylelint", ["pnpm", "exec", "stylelint", "**/*.css"])
    problems += _run("G5 prettier --check", ["pnpm", "exec", "prettier", "--check", "."])
    if full:
        problems += _run("vitest run", ["pnpm", "exec", "vitest", "run"])
    return problems


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="G5/G6/G13 TypeScript lint/type-check/format/test contract (P0.4.7)")
    ap.add_argument("--full", action="store_true", help="the G13 whole-project + the vitest leg (L2/push)")
    args = ap.parse_args(argv)

    structural = freeze_contract()
    if structural:
        # A broken/gutted contract (e.g. a PKG_REQUIRED_SCRIPTS tool with no _TOOL_CONFIG detector) is
        # FATAL before the live tier: the live asserts trust the contract to be well-formed (the
        # assert_toolchain_wiring loop indexes _TOOL_CONFIG by each contract tool), so a contract defect
        # short-circuits here rather than reaching a malformed-state crash downstream.
        print(f"[G5/G6/G13] {structural} contract violation(s)", file=sys.stderr)
        return 1

    manifest = _frontend_manifest()
    if manifest is None:
        print("[G5/G6/G13] TS-gate contract frozen; no frontend package.json yet (the workspace + TS "
              "sources land in P1) — live tsc/eslint/stylelint/prettier/vitest skipped (target-absent)")
        return 0

    live = (assert_tsconfig_strict() + assert_eslint_rules() + assert_eslint_sink_ban()
            + assert_toolchain_wiring(manifest) + run_live_tools(args.full))
    # a `2` (missing/malformed config) from the strict/wiring asserts surfaces as a hard fail too
    if live:
        print(f"[G5/G6/G13] {live} TS-gate contract violation(s)", file=sys.stderr)
        return 1
    print("[G5/G6/G13] TypeScript lint/type-check/format/test contract OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
