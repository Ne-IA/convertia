# --- check 23 (the G68 sibling): the owner-decidable / informational-then-ratcheted gate-status ledger.
# _OWNER_DECIDABLE_GATES is the canonical registry of the informational-then-ratcheted gates (value
# informational / required) plus the owner decisions that replaced a registered posture (value decided),
# kept so a silent re-promotion reds. The KEY is matched case-insensitively as a WHOLE
# delimited TOKEN in the ledger row's first column (via _key_binds, so `cargo-acl`/cackle and a back-ticked
# `Kani` bind but a near-miss like `cargo-aclx` does NOT); the VALUE is the effective posture the ledger
# row MUST agree with. INVARIANT: no key may be a substring of another. A flip edits BOTH the ledger row AND this
# map in the SAME owner-acked L(-1) commit — the dual record that makes a posture change a
# dated, auditable change, never an invisible drift (build-gates §6 check 23). A gate enters with the box that
# authors it; a one-time adopt with no prior posture (G59) stays out.
_OWNER_DECIDABLE_GATES = {
    "cargo-acl":     "decided",         # cackle dependency-graph capability cap (P0.4.5) — declined for v1 (gate-status.md)
    "kani":          "decided",         # bounded model checking of the numeric caps (P0.4.5) — declined for v1 (gate-status.md)
    "cargo-careful": "decided",         # runtime-UB / extra-assertion nightly wrapper (P0.4.5) — declined for v1 (gate-status.md)
    "cargo-geiger":  "decided",         # unsafe-usage census (P0.4.5) — declined for v1 (gate-status.md)
    "cargo-mutants": "informational",   # scoped mutation testing of the fs_guard/detect/outcome kernel, G15 sub-leg (P0.5.10); owner flips ->required at 0 survived for fs_guard+detect (P3.72 ratchet)
    "g17b":          "informational",   # bundled-engine CVE awareness (osv-scanner/grype over the PURL-keyed engines.lock) (P0.7.7); owner flips ->required via the CVSS>=7-on-an-actively-exercised-section-04-path release-blocking escalation (vuln-response.md / SECURITY.md)
    "g64":           "informational",   # privilege-drop-tier ratchet over the §2.12.3 runtime containment (P0.7.14); decrease-guarded privilege-drop-coverage.toml; owner flips ->required once the tier matrix stabilises (informational while filled P4-P9)
    "g65":           "decided",         # engine-subprocess coverage-guided fuzz, reserved-not-row id (P0.7.15) — required weekly scheduled issue-opener (P9.36), no per-push leg — decided
}
_GATE_STATUSES = {"informational", "required", "decided"}
_ISO_DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def _is_iso_calendar_date(s: str) -> bool:
    """True iff `s` is a REAL calendar date — strictly stronger than the YYYY-MM-DD SHAPE regex, which
    alone would accept impossible dates like 2026-13-99 / 2026-00-00. Used together with _ISO_DATE (the
    regex enforces the dashed shape; this rejects an out-of-range month/day). Stdlib-only."""
    try:
        datetime.date.fromisoformat(s)
        return True
    except ValueError:
        return False


def _key_binds(key: str, name_lower: str) -> bool:
    """True iff registry `key` appears in `name_lower` as a whole identifier token — delimited by
    start/end or a non-[word-or-hyphen] char — so `cargo-acl` binds the ledger name `` `cargo-acl` / cackle ``
    but NOT a near-miss like `cargo-aclx` or `cargo-acl-ng` (the P0.4.5 G1 P3 substring-footgun fix).
    INVARIANT: no _OWNER_DECIDABLE_GATES key may be a substring of another (cargo-acl / kani /
    cargo-careful / cargo-geiger all satisfy this), and a ledger name must contain the exact key token."""
    return re.search(r"(?<![\w-])" + re.escape(key) + r"(?![\w-])", name_lower) is not None


def _parse_status_rows(text: str) -> list[tuple[str, str, str, int]]:
    """The data rows of the gate-status ledger table — (name_cell, status_lower, since, lineno). The
    ledger table is the markdown table whose header row names BOTH a `Status` and a `Since` column; only
    ITS data rows are parsed (any other table in the doc is ignored). Fence-aware; the all-dashes
    separator row is skipped without ejecting the table."""
    rows: list[tuple[str, str, str, int]] = []
    in_table = False
    for ln, raw in _strip_fenced(text):
        line = raw.strip()
        if not line.startswith("|"):
            in_table = False
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        low = [c.lower() for c in cells]
        if "status" in low and "since" in low:        # the ledger header row
            in_table = True
            continue
        if set(line) <= set("|-: "):                  # the header separator row (---|---) — skip, keep table
            continue
        if in_table and len(cells) >= 3:
            rows.append((cells[0], cells[1].lower(), cells[2], ln))
    return rows


def doc23_ratchet_log(ctx: Ctx) -> list[Finding]:
    """Check 23: the owner-decidable / informational-then-ratcheted gate-status decision-log. Every gate
    in _OWNER_DECIDABLE_GATES has a dated, well-formed `docs/process/gate-status.md` ledger row whose
    status AGREES with its effective posture, and every parsed ledger row is itself well-formed — so a
    posture flip is a dated committed line, never an invisible informational<->required change
    (build-gates §6 check 23 / the G68 sibling). A missing ledger is a finding."""
    F = "docs/process/gate-status.md"
    text = ctx.docs.get(F, "")
    if not text:
        return _target_missing("23:ratchet-log", F)
    out: list[Finding] = []
    rows = _parse_status_rows(text)
    # (1) every parsed row is well-formed — no malformed status / non-ISO date may hide in the ledger
    for name, status, since, ln in rows:
        if status not in _GATE_STATUSES:
            out.append(Finding("23:ratchet-log", F, ln,
                               f"ledger row {name!r}: status {status!r} is not one of {sorted(_GATE_STATUSES)}"))
        if not _ISO_DATE.match(since) or not _is_iso_calendar_date(since):
            out.append(Finding("23:ratchet-log", F, ln,
                               f"ledger row {name!r}: 'Since' {since!r} is not a valid ISO YYYY-MM-DD date"))
    # (2) every registered owner-decidable gate has a row whose status agrees with the effective posture
    for key, expected in _OWNER_DECIDABLE_GATES.items():
        matches = [r for r in rows if _key_binds(key, r[0].lower())]
        if not matches:
            out.append(Finding("23:ratchet-log", F, 0,
                               f"owner-decidable gate {key!r} has no dated status row "
                               f"(plan-lint check 23 / P1.62.10)"))
            continue
        for name, status, since, ln in matches:
            if status in _GATE_STATUSES and status != expected:
                out.append(Finding("23:ratchet-log", F, ln,
                                   f"ledger row {name!r}: status {status!r} disagrees with the effective "
                                   f"posture {expected!r} — a flip must edit BOTH the ledger row AND the "
                                   f"check-23 _OWNER_DECIDABLE_GATES posture map in the same commit"))
    return out


def doc24_p0_completion(ctx: Ctx) -> list[Finding]:
    """Check 24: docs/process/p0-completion.md run_url: matches the immutable Actions-run URL pattern. A
    missing record, or a record without a `run_url:` field, is a finding."""
    F = "docs/process/p0-completion.md"
    p0c = ctx.docs.get(F, "")
    if not p0c:
        return _target_missing("24:p0-completion-record", F)
    m = re.search(r"run_url:\s*(\S+)", p0c)
    if m is None:
        return _target_missing("24:p0-completion-record", F, f"the `run_url:` field of {F}")
    out = []
    if not re.match(r"https://github\.com/Ne-IA/convertia/actions/runs/\d+\b", m.group(1)):
        out.append(Finding("24:p0-completion-record", F, 0,
                           f"run_url {m.group(1)!r} does not match https://github.com/Ne-IA/convertia/actions/runs/<id>"))
    return out


# --- check 26 (G69): structural-map integrity — the tracked tree <-> spec §0.7 bind ------------------
# Spec §0.7 "Physical tree" is the repository's directory map: an ASCII tree-art fenced block (├─/│/└─ +
# `#` annotations, variable connector width) that lists directories only. _parse_tree_dirs reconstructs
# the repo-relative DIR set from it using a width-agnostic indent STACK (the parent of a line is the
# nearest shallower-indented dir), and additionally mines sibling dirs on one line (`a/  b/  c/`) and
# ancestor dirs implied by an embedded path (`lib/ipc/x.ts` -> lib, lib/ipc). A file name is ignored;
# only directories are asserted. The files the architecture depends on by path are §0.7's separate
# *Load-bearing files* list, and each of them must be tracked.
_STRUCT_IGNORE = {"target", "node_modules", "dist", ".git"}   # the committed out-of-scope-tree ignore set
_TREE_CHARS = "│├└─ \t"
_NAME_TOKEN = re.compile(r"^[A-Za-z0-9._\-/]+/?$")
_ANNOT_DELIM = re.compile(r"[→#(]")   # an annotation opens at `#` (the tree's convention) or `→`; '(' opens a parenthetical


def _name_tokens(stripped: str) -> list[str]:
    """The path-name tokens of a tree line's NODE portion — everything LEFT of the first annotation
    delimiter (→ / # / '('), so trailing prose can never contribute phantom dirs (the G1 r1 hardening).
    Stops at the first token that is not a path name."""
    head = _ANNOT_DELIM.split(stripped, 1)[0]
    out = []
    for tok in head.split():
        if not _NAME_TOKEN.match(tok):
            break
        out.append(tok)
    return out


def _parse_tree_dirs(block_lines: list[str]) -> set[str]:
    """Repo-relative DIR paths named in a tree-art block. The single indent-0 line (convertia/) is the
    repo root (path ''); its descendants are mapped relative to it. Width-agnostic (an indent STACK, not
    a fixed unit). Handles same-line sibling dirs and embedded-path ancestor dirs."""
    stack: list[tuple[int, str]] = []        # (indent, dir-path) parent chain
    dirs: set[str] = set()
    for raw in block_lines:
        stripped = raw.lstrip(_TREE_CHARS)
        if not stripped:
            continue
        indent = len(raw) - len(stripped)
        tokens = _name_tokens(stripped)
        if not tokens:
            continue
        while stack and stack[-1][0] >= indent:
            stack.pop()
        parent = stack[-1][1] if stack else ""
        if indent == 0:                      # the repo-root line (convertia/) — not a mapped subdir
            stack.append((0, ""))
            continue
        for j, tok in enumerate(tokens):
            is_dir = tok.endswith("/")
            segs = [s for s in tok.strip("/").split("/") if s]
            if not segs:
                continue
            if j == 0:                       # the tree NODE — mine its embedded-path ancestor dirs
                cur = parent
                for k, s in enumerate(segs):
                    cur = f"{cur}/{s}" if cur else s
                    if k < len(segs) - 1 or is_dir:   # an intermediate path segment, or a final dir segment
                        dirs.add(cur)
            elif is_dir and len(segs) == 1:  # a same-line sibling — only a SIMPLE dir token, never an embedded path
                dirs.add(f"{parent}/{segs[0]}" if parent else segs[0])
        if tokens[0].endswith("/"):          # deeper following lines nest under the first token's dir
            push = parent
            for s in (s for s in tokens[0].strip("/").split("/") if s):
                push = f"{push}/{s}" if push else s
            stack.append((indent, push))
    return dirs


def _fenced_block_after(text: str, header_re: re.Pattern) -> list[str] | None:
    """The lines of the first ``` / ~~~ fenced block AFTER the first line matching header_re (None if
    no header or no fence)."""
    lines = text.split("\n")
    hdr = next((i for i, ln in enumerate(lines) if header_re.search(ln)), None)
    if hdr is None:
        return None
    j = hdr + 1
    while j < len(lines) and not lines[j].lstrip().startswith(("```", "~~~")):
        j += 1
    if j >= len(lines):
        return None
    fence = lines[j].lstrip()[:3]
    start = j + 1
    k = start
    while k < len(lines) and not lines[k].lstrip().startswith(fence):
        k += 1
    return lines[start:k]


def _section_text(text: str, header_re: re.Pattern) -> str:
    """The text of the section opened by the first line matching header_re, up to the next heading of
    the same or higher level ('' if no such header)."""
    lines = text.split("\n")
    start = next((i for i, ln in enumerate(lines) if header_re.search(ln)), None)
    if start is None:
        return ""
    hm = re.match(r"^(#{1,6})", lines[start])
    level = len(hm.group(1)) if hm else 2
    end = len(lines)
    for j in range(start + 1, len(lines)):
        h = re.match(r"^(#{1,6})\s", lines[j])
        if h and len(h.group(1)) <= level:
            end = j
            break
    return "\n".join(lines[start:end])


def _dirs_from_files(files: list[str]) -> set[str]:
    """Every ancestor dir of a tracked-file path (minus the out-of-scope top-level trees)."""
    dirs: set[str] = set()
    for f in files:
        parts = [p for p in f.replace("\\", "/").split("/") if p]
        for i in range(1, len(parts)):
            d = "/".join(parts[:i])
            if d.split("/")[0] not in _STRUCT_IGNORE:
                dirs.add(d)
    return dirs


def _git_ls_files(root: Path) -> list[str] | None:
    """The tracked file paths from `git ls-files` (tracked files only, so untracked scratch never
    false-fails). Uses `-c core.quotepath=false -z` so non-ASCII / space-bearing paths arrive as raw
    UTF-8 with no octal-escaping or quoting (no mangled names). None if git is unavailable / errors
    (the caller fails closed)."""
    try:
        r = subprocess.run(["git", "-c", "core.quotepath=false", "ls-files", "-z"],
                           cwd=str(root), capture_output=True, text=True, encoding="utf-8", errors="replace")
    except OSError:
        return None
    if r.returncode != 0:
        return None
    return [f for f in r.stdout.split("\0") if f]


def _struct_map_relations(spec07_dirs: set[str], disk_dirs: set[str]) -> list[tuple[str, str]]:
    """The two directions of the bind as (kind, dir) tuples — pure, set-only (testable without git or
    the filesystem)."""
    out = [("disk-not-in-spec07", d) for d in sorted(disk_dirs - spec07_dirs)]
    out += [("spec07-not-on-disk", d) for d in sorted(spec07_dirs - disk_dirs)]
    return out


_STRUCT_MSG = {
    "disk-not-in-spec07": "tracked dir '{d}' has no spec §0.7 Physical-tree row — add it in the commit "
                          "that adds the directory's first file",
    "spec07-not-on-disk": "spec §0.7 names dir '{d}' with no tracked file beneath it — remove the row or "
                          "add the directory's first file",
}
_ARCH_DOC = "docs/spec/00-architecture.md"
_PHYSICAL_TREE_HDR = re.compile(r"^#{1,6}.*Physical tree")
_LOAD_BEARING_HDR = re.compile(r"^#{1,6}\s+Load-bearing files\b")
_LOAD_BEARING_ITEM = re.compile(r"^\s*[-*]\s+`([^`\s]+)`")


def _load_bearing_paths(arch: str) -> list[str] | None:
    """The paths of spec §0.7's *Load-bearing files* list, in order: one per bullet that opens with a
    code-span path. None when the section is missing; [] when it lists no such bullet."""
    sec = _section_text(arch, _LOAD_BEARING_HDR)
    if not sec:
        return None
    return [mt.group(1) for ln in sec.split("\n") if (mt := _LOAD_BEARING_ITEM.match(ln))]


def doc26_struct_map(ctx: Ctx) -> list[Finding]:
    """Check 26 (G69): spec §0.7 "Physical tree" (directories only) is bound BOTH ways to the
    `git ls-files`-derived directory set, minus the committed out-of-scope trees: (1) a tracked dir with
    no §0.7 row fails; (2) a §0.7 dir with no tracked file beneath it fails. (3) Every path on §0.7's
    *Load-bearing files* list is tracked. A missing, unparseable or empty tree block, a missing or empty
    load-bearing list and an unavailable git each fail CLOSED; the check has no skip branch."""
    arch = ctx.docs.get(_ARCH_DOC, "")
    spec_block = _fenced_block_after(arch, _PHYSICAL_TREE_HDR)
    if spec_block is None:
        return [Finding("26:struct-map", _ARCH_DOC, 0,
                        "the §0.7 Physical tree fenced block is absent/unparseable — cannot bind the "
                        "tracked tree (fail-closed)")]
    spec07_dirs = _parse_tree_dirs(spec_block)
    if not spec07_dirs:
        return [Finding("26:struct-map", _ARCH_DOC, 0,
                        "the §0.7 Physical tree block names no directory — cannot bind the tracked tree "
                        "(fail-closed)")]
    files = _git_ls_files(ctx.root)
    if files is None:
        return [Finding("26:struct-map", _ARCH_DOC, 0,
                        "git ls-files failed — cannot derive the tracked directory set (fail-closed)")]
    out = [Finding("26:struct-map", _ARCH_DOC, 0, _STRUCT_MSG[kind].format(d=d))
           for kind, d in _struct_map_relations(spec07_dirs, _dirs_from_files(files))]
    load_bearing = _load_bearing_paths(arch)
    if load_bearing is None:
        out.append(Finding("26:struct-map", _ARCH_DOC, 0,
                           "the §0.7 'Load-bearing files' section is missing — fail-closed"))
    elif not load_bearing:
        out.append(Finding("26:struct-map", _ARCH_DOC, 0,
                           "the §0.7 'Load-bearing files' section lists no `path` bullet — fail-closed"))
    else:
        tracked = set(files)
        out += [Finding("26:struct-map", _ARCH_DOC, 0, f"load-bearing file '{p}' is not tracked")
                for p in load_bearing if p not in tracked]
    return out


def _completed_phases(boxes: list[Box]) -> set[str]:
    """{'P<n>'} for every phase whose boxes are ALL marker=='x' (>=1 box, none open/blocked/extern).
    Used by check 27 to know when a scheduled fail-soft -> fail-closed flip is DUE."""
    done: set[str] = set()
    for p in {b.phase for b in boxes}:
        pboxes = [b for b in boxes if b.phase == p]
        if pboxes and all(b.marker == "x" for b in pboxes):
            done.add(f"P{p}")
    return done


def _posture_wired_in(text: str, script: str, flag: str) -> bool:
    """True iff a NON-comment line invokes `script` (matched by basename) carrying `flag`. A full-line
    `#` comment AND a trailing inline comment (` # ...`) are stripped first, so a flag mentioned only
    in a comment (`run: ... # --enforce`) or in prose does NOT count as wired - the exact
    'promised, not applied' shape this prevention targets. A missing/empty plane text is NOT wired."""
    base = script.rsplit("/", 1)[-1]
    for line in text.splitlines():
        s = line.split(" #", 1)[0].strip()      # drop a trailing inline comment before the test
        if not s or s.startswith("#"):
            continue
        if base in s and flag in s:
            return True
    return False


def _gate_posture_findings(posture_rows: list, fail_open_gates: set[str],
                           completed_phases: set[str], plane_texts: dict[str, str]) -> list[str]:
    """Pure core of check 27. For each posture-flag gate: once `fail_closed_after_phase` is COMPLETE,
    the gate MUST be invoked with `enforce_flag` in EVERY `plane` AND carry no [[fail_open]] excuse;
    while the phase is INCOMPLETE the soft posture must be justified (a fail_open row) or already wired.
    Returns a list of finding messages (empty = sound)."""
    out: list[str] = []
    for pf in posture_rows:
        if not isinstance(pf, dict):
            out.append("check 27: a [[posture_flag]] row is not a table (fail-closed)")
            continue
        gate = str(pf.get("gate", "?")).strip() or "?"
        script = str(pf.get("script", "")).strip()
        flag = str(pf.get("enforce_flag", "")).strip()
        phase = str(pf.get("fail_closed_after_phase", "")).strip()
        planes = [p for p in (pf.get("planes") or []) if isinstance(p, str) and p.strip()]
        if not (script and flag and phase and planes):
            out.append(f"check 27: posture_flag {gate!r} is under-specified "
                       "(needs script/enforce_flag/fail_closed_after_phase/planes)")
            continue
        if phase in completed_phases:
            if gate in fail_open_gates:
                out.append(f"check 27: {gate} is due fail-CLOSED ({phase} complete) but a [[fail_open]] "
                           "row still excuses its soft posture - remove the fail_open row")
            for p in planes:
                if not _posture_wired_in(plane_texts.get(p, ""), script, flag):
                    out.append(f"check 27: {gate}'s scheduled fail-soft -> fail-closed flip is DUE "
                               f"({phase} complete) but `{script} {flag}` is NOT wired in {p!r} - the "
                               "posture transition was promised but never wired (the G71/P1 defect class)")
        elif gate not in fail_open_gates and not all(
                _posture_wired_in(plane_texts.get(p, ""), script, flag) for p in planes):
            out.append(f"check 27: {gate} is fail-soft ({phase} not complete) but carries no [[fail_open]] "
                       f"justification and is not wired enforcing - add a fail_open row or wire `{flag}`")
    return out


def doc27_gate_posture_transition(ctx: Ctx) -> list[Finding]:
    """Check 27 (the G71/P1 prevention): every posture-flag gate's SCHEDULED fail-soft -> fail-closed
    transition is mechanically honored. Reads the [[posture_flag]] registry in scripts/gate-planes.toml;
    for each row, once its `fail_closed_after_phase` is COMPLETE (every plan box of that phase is [x]),
    asserts the gate is actually invoked with its `enforce_flag` in every `plane` file AND no
    [[fail_open]] row still excuses it. A missing gate-planes.toml, an empty [[posture_flag]] registry, a
    due-but-unwired flip and an unparseable config are each a finding."""
    GP = "scripts/gate-planes.toml"
    gp = ctx.root / GP
    if not gp.is_file():
        return _target_missing("27:gate-posture-transition", GP)
    try:
        data = tomllib.loads(gp.read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError:
        return [Finding("27:gate-posture-transition", GP, 0,
                        "gate-planes.toml is unparseable - cannot verify posture-flag transitions (fail-closed)")]
    posture_rows = data.get("posture_flag", [])
    if not isinstance(posture_rows, list) or not posture_rows:
        return _target_missing("27:gate-posture-transition", GP, f"the [[posture_flag]] registry in {GP}")
    fail_open_gates = {str(x.get("gate", "")).strip()
                       for x in data.get("fail_open", []) if isinstance(x, dict)}
    plane_paths = {p for pf in posture_rows if isinstance(pf, dict)
                   for p in (pf.get("planes") or []) if isinstance(p, str) and p.strip()}
    plane_texts = {p: ((ctx.root / p).read_text(encoding="utf-8", errors="replace")
                       if (ctx.root / p).is_file() else "") for p in plane_paths}
    return [Finding("27:gate-posture-transition", GP, 0, msg)
            for msg in _gate_posture_findings(posture_rows, fail_open_gates,
                                              _completed_phases(ctx.boxes), plane_texts)]


# --- check 29: stale liveness/futurity claims in .rs comments (the P4.23 L(-1) hand-off) ---------
# A .rs comment or lint-`reason` string asserting present-tense DEADNESS bounded by a plan box
# ("stays dead until P4.32 wires it", "no production caller until P6.10", "once P2.34 lands") goes
# flat-false the moment that box lands, and THREE protections miss it: expect(dead_code) stays
# fulfilled while one clause of a long reason rots (other items are still dead), G68 is .md-only, and
# a line-based grep cannot see a claim spanning two comment lines. The Loop-memory entry
# `stale-liveness-futurity-claims` records the class + the sweep method; this check is its mechanical
# form (steps 1-3): JOIN each contiguous //-family comment run (and each reason = "..." string) into
# one string, match the DEADNESS-UNTIL-BOUND constructions, capture the BOUND box-id directly from
# the construction, and fail iff that id is [x] in docs/plan/P*.md.
#
# Calibrated against the live tree (2026-08-30: 21 raw candidates -> 14 genuinely stale constructions,
# 15 sites corrected in the arming commit). Deliberate narrowings, each a recorded residual, so the
# check stays fail-closed-green with ZERO escape markers:
#   * the bound id is read from a 45-char window after the until/once/lands-at keyword, truncated at
#     the first of ; ) ! ? ( or a '.' NOT followed by a digit (a box-id's own dot survives - see
#     _FUT_WINDOW_STOP) - an id in a trailing parenthetical (a `needs:` cite) or the next
#     sentence is NOT the bound;
#   * a PAST-tense narration ("stayed/remained/was/were dead until X made it live") is history;
#   * text inside double quotes and inside the repo's bracket tags ([Corrected by ...],
#     [Build-Session-Entscheidung: ...], [Test-Change: ...], [Raised by ...]) is mention/attribution,
#     stripped before matching (a SINGLE-quoted mention is NOT stripped - apostrophes make that
#     unsafe: quote old claims with double quotes or paraphrase them);
#   * boundless futurity ("until then", "until those land", "until consumed") names no id and cannot
#     be mechanically bound - the test-strategy §11.4 surface-(e) audit + the sweep memory own it.
_RS_COMMENT_LINE = re.compile(r"^\s*//[/!]?(.*)$")
_RS_REASON_OPEN = re.compile(r'reason\s*=\s*(r#*"|")')
_FUT_TAG_SPAN = re.compile(
    r"\[(?:Corrected by|Build-Session-Entscheidung:?|Test-Change:?|Raised by|Derived-Assumption:?"
    r"|DECIDED)[^\]]*\]")
_FUT_QUOTE_SPAN = re.compile(r'"[^"]{0,300}?"')
_FUT_PID = r"P\d+\.\d+(?:\.\d+)?"
_FUT_DEAD = r"(?:dead|dormant|empty|unread|unreachable|unwired|absent|inert|unregistered)"
_FUT_CONSTRUCTS = (
    ("state-until", re.compile(
        r"\b(?:stays?|remains?|is|are|kept|left)\s+(?:\w+[\s-]+){0,4}?" + _FUT_DEAD
        + r"\b[^.;!?]{0,100}?\b(?:until|before)\s+", re.IGNORECASE)),
    ("dead-until", re.compile(
        r"(?<!stayed )(?<!remained )(?<!was )(?<!were )\b" + _FUT_DEAD
        + r"\s+(?:in\s+the\s+\w+\s+build\s+)?(?:until|before)\s+", re.IGNORECASE)),
    ("no-caller-until", re.compile(
        r"\b(?:no|without|zero)\s+(?:production\s+)?(?:callers?|calls?|readers?|consumers?|uses?)\b"
        r"[^.;!?]{0,60}?\b(?:until|before)\s+", re.IGNORECASE)),
    ("not-live-until", re.compile(
        r"\bnot\s+(?:wired|live|called|registered|reachable|spawned|consumed|built)\b"
        r"[^.;!?]{0,60}?\b(?:until|before)\s+", re.IGNORECASE)),
    ("lands-at", re.compile(r"\blands?\s+(?:at|in|with)\s+(?:the\s+)?(?=" + _FUT_PID + ")",
                            re.IGNORECASE)),
    # once-P guards the POST-id verb: "once P4.4 lands" is a claim, "once P4.4 landed" is history
    # (the past marker follows the id here, so a lookbehind cannot carry it - the R1 opus P2).
    ("once-P", re.compile(
        r"\bonce\s+(?:the\s+)?(?=" + _FUT_PID
        + r"\b(?!\s+(?:landed|wired|had|was|made|added|delivered|closed|did|shipped|arrived|went"
        + r"|completed|became)\b))", re.IGNORECASE)),
)
_FUT_PID_RE = re.compile(_FUT_PID)
# A '.' between digits is a box-id dot (P3.48), NOT a sentence stop — the g24 positive legs caught
# the naive [.;)!?(] class truncating EVERY bound id to "P3" and leaving the check green-but-blind.
_FUT_WINDOW_STOP = re.compile(r"[;)!?(]|\.(?!\d)")


def _rs_comment_blocks(text: str) -> list[tuple[int, str]]:
    """(start_lineno, joined) for each contiguous //-family comment run (step 1 of the sweep method:
    JOIN first, match second — the claim routinely spans two comment lines) plus each lint
    reason = "…" attribute string (the other rot carrier P4.23 found), newline-flattened."""
    blocks: list[tuple[int, str]] = []
    cur: list[str] = []
    start = 0
    for i, line in enumerate(text.splitlines(), 1):
        m = _RS_COMMENT_LINE.match(line)
        if m:
            if not cur:
                start = i
            cur.append(m.group(1).strip())
        else:
            if cur:
                blocks.append((start, " ".join(cur)))
                cur = []
    if cur:
        blocks.append((start, " ".join(cur)))
    for m in _RS_REASON_OPEN.finditer(text):
        opener, s = m.group(1), m.end()
        if opener == '"':
            j, buf = s, []
            while j < len(text):
                c = text[j]
                if c == "\\" and j + 1 < len(text):
                    buf.append(text[j + 1])
                    j += 2
                    continue
                if c == '"':
                    break
                buf.append(c)
                j += 1
            content = "".join(buf)
        else:
            closer = '"' + "#" * opener.count("#")
            j = text.find(closer, s)
            content = text[s:j] if j != -1 else text[s:]
        blocks.append((text.count("\n", 0, m.start()) + 1, content.replace("\n", " ")))
    return blocks


def _stale_liveness_problems(files: dict[str, str], done: set[str]) -> list[tuple[str, int, str]]:
    """(pure) the check-29 core over {relpath -> rust source}: every deadness-until-bound construction
    whose captured bound id is in `done` (the [x] set). Deduped per (file, block, bound-id set)."""
    problems: list[tuple[str, int, str]] = []
    seen: set[tuple[str, int, str]] = set()
    for rel in sorted(files):
        for lineno, joined in _rs_comment_blocks(files[rel]):
            s = _FUT_QUOTE_SPAN.sub(" ", _FUT_TAG_SPAN.sub(" ", joined))
            for name, rx in _FUT_CONSTRUCTS:
                for m in rx.finditer(s):
                    window = s[m.end():m.end() + 45]
                    stop = _FUT_WINDOW_STOP.search(window)
                    if stop:
                        window = window[:stop.start()]
                    landed = sorted(set(_FUT_PID_RE.findall(window)) & done)
                    if not landed:
                        continue
                    key = (rel, lineno, ",".join(landed))
                    if key in seen:
                        continue
                    seen.add(key)
                    problems.append((rel, lineno,
                                     f"a {name} futurity construction is bounded by "
                                     f"{'/'.join(landed)}, which is [x] — the comment asserts a "
                                     f"dead-ness that box ended; reword it to the live truth, verifying "
                                     f"every subject against its real call sites (Loop-memory "
                                     f"`stale-liveness-futurity-claims`) near: "
                                     f"…{s[max(0, m.start() - 40):m.end() + 45]}…"))
    return problems


def doc29_stale_liveness(ctx: Ctx) -> list[Finding]:
    """Check 29: stale liveness/futurity claims in .rs comments + lint-reason strings (the P4.23
    L(-1) hand-off; build-gates §6 check 29). A present-tense dead-ness assertion bounded by a LANDED
    plan box fails — the bound id is captured from the construction itself, never a whole-block
    intersect. Scope: src-tauri/src + crates + xtask/src (first-party Rust; the planted
    tests/g53-fixture tree and the fuzz harness are deliberately out). A missing scope root is a
    finding."""
    roots = ("src-tauri/src", "crates", "xtask/src")
    missing = [f for rel in roots if not (ctx.root / rel).is_dir()
               for f in _target_missing("29:stale-liveness", rel)]
    if missing:
        return missing
    files: dict[str, str] = {}
    for rel in roots:
        for f in (ctx.root / rel).rglob("*.rs"):
            files[str(f.relative_to(ctx.root)).replace("\\", "/")] = f.read_text(
                encoding="utf-8", errors="replace")
    done = {b.box_id for b in ctx.boxes if b.marker == "x"}
    return [Finding("29:stale-liveness", rel, ln, msg)
            for rel, ln, msg in _stale_liveness_problems(files, done)]


# =============================================================================================
#  Check registry — FORMAT checks live; doc checks 1..33 added incrementally (P0.3.5 + P1.66).
# =============================================================================================
# --- check 30: spec-restatement fidelity (the P4.33 QuarantinedByOs reconcile's class catcher) ---------
# One canonical user-facing string has ONE home — the §2.8.2 / §2.9.1 tables in 02-guarantees.md — and every
# other docs/spec/** file - or the SSOT, which outranks the spec - that quotes it must quote it VERBATIM
# (docs/plan quotes are history, out of scope - a named residual) (whitespace-squashed, the markdown `\"` escape
# undone). The drift this catches reached `main` once: §7.2.4 restated the QuarantinedByOs row in different
# words, both texts claimed to be canonical, and no gate compared them. The in-crate bind in `crate::outcome`
# covers the three cross-file sites it enumerates; this is the general rule over the files that crate does
# not read. A RESTATEMENT has quotation shape: a `"…"` span in the other file carrying any five CONSECUTIVE
# tokens of a canonical string (words case-folded with their punctuation stripped — a case- or
# punctuation-only difference is a drift to the verbatim test and must not hide a run from this one, the
# round-4 G1 finding: `text only — layout and images are dropped` sat in 05-ui-ux unseen), without the
# whole string being present, is quoting it and has drifted (a sliding window sees a change wherever some
# five-token run excludes it; a string of NINE tokens or fewer has positions every run shares — a change
# at token i is invisible iff N-5 <= i <= 4 — so its quotations are judged by token similarity AS WELL:
# the same length within one token and all but one token in common, the round-3 G1 finding that 16 of
# the 53 strings had an unseen middle). Bold or plain prose that shares the
# words — a UI path spelled out as steps, a format's
# feature list, a paraphrase — is description, not restatement, and is left alone (calibrated on the live
# tree: the §6.2.4 "Open System Settings → Privacy & Security" steps and the presentations matrix's
# "SmartArt, modern charts, and newer transitions" description are exactly those). Stdlib-only; a
# 02-guarantees.md that yields no catalog string is a finding.
_CANON_BOLD_RE = re.compile(r'\*\*"(.+?)"\*\*')
_CANON_SECTIONS = ("### 2.8.2", "### 2.9.1")
# A quotation span is the SHORTEST `"…"` run that is word-bounded outside (a `"` glued to a word, like
# `12"`, is not a quote mark) and crosses no markdown mark (`*`, `|`). It MAY contain inner `"…"` fragments
# of up to 200 characters, because two catalog strings carry one (`click "Open Anyway" next to`, `The
# output name "{name}"`) and a DRIFTED quotation of either keeps it — the first cut of this check forbade
# an inner quote and so saw NEITHER string, the historical §7.2.4 drift included (the round-1 G1 finding;
# the nested-drift and historical-replay legs pin the fix). Lazy matching takes the first valid closing
# mark, so an inner fragment is consumed only when the mark after it is glued to a word (`"Open`); a
# fragment opening with a non-word char (`"{name}"`) closes the span early and splits the quotation in
# two — harmless for a DRIFTED quotation (its halves still carry the runs) and harmless for a VERBATIM one
# only because every verbatim-present canonical string is blanked out of the body BEFORE the spans are cut
# (the round-2 G1 finding: blanking the span text instead let a correct `"{name}"` quotation fire). A
# span over 400 characters (the longest catalog string is under 200) is a sweep between two unrelated
# marks, not a quotation, and is discarded — a naive pairing pairs a CLOSING mark with the next OPENING
# one after any odd mark and sweeps the prose between two unrelated quotations into a bogus span. Every
# clause has its own canary leg. Named residuals (each measured; none occurs in docs/spec today): a
# drifted quotation whose inner fragment exceeds 200 characters, or that carries a `*`/`|` inside the
# marks, or that is set in underscore italics (`_"…"_` — `_` is a word char, so the mark does not open),
# or whose closing mark is glued to a word, cuts no span and is not seen; a two-token change to a string
# of nine tokens or fewer that leaves no five-token run intact is a paraphrase to both rules; a canonical string
# of nine tokens or fewer that ITSELF carries an inner quote would split its quotation into two halves too short
# for either rule - none exists (the short strings carry no inner quote; the canary pins that precondition on the
# real catalog, the round-12 review). Curly quotes are normalised to the straight mark before the spans are cut.
_QUOTE_SPAN_RE = re.compile(r'(?<!\w)"((?:[^"*|]|"[^"*|]{1,200}")+?)"(?!\w)')
_SPAN_MAX = 400
_ANCHOR_WORDS = 5
_SHORT_WORDS = 9      # at most nine tokens: every five-token run shares a position, so runs cannot see a mid drift


def _tokens(s: str) -> list[str]:
    """The comparison tokens of a string: each whitespace-separated word case-folded with its leading and
    trailing ASCII punctuation stripped; a word that was only punctuation (a bare `-`, `&`) drops out. An
    em dash is not ASCII punctuation and stays a token on both sides alike."""
    return [t for t in (w.strip(string.punctuation).casefold() for w in s.split()) if t]


def _restates(span_tokens: list[str], canonical: str) -> bool:
    """Does any span (given as its space-joined tokens) carry any `_ANCHOR_WORDS`-token run of `canonical`?"""
    words = _tokens(canonical)
    runs = [" ".join(words[i:i + _ANCHOR_WORDS]) for i in range(len(words) - _ANCHOR_WORDS + 1)]
    return any(f" {run} " in f" {st} " for st in span_tokens for run in runs)


def _short_drift(span_tokens: str, canonical: str) -> bool:
    """Is the span (its space-joined tokens) a one-token-off quotation of the SHORT `canonical` string? Same
    token count within one, and all but one of the canonical tokens matched in order (difflib's matching
    blocks) — a two-token change is a paraphrase and is left to the run anchor; a verbatim quotation never
    reaches here (blanked first)."""
    a, b = span_tokens.split(), _tokens(canonical)
    if abs(len(a) - len(b)) > 1:
        return False
    matched = sum(bl.size for bl in difflib.SequenceMatcher(None, a, b).get_matching_blocks())
    return matched >= len(b) - 1


def _squash_ws(s: str) -> str:
    return " ".join(s.split())


def _canonical_strings(guarantees: str) -> list[str]:
    """Every `**"…"**` literal inside the §2.8.2 and §2.9.1 sections of 02-guarantees.md (a section runs to
    the next `### ` heading), whitespace-squashed and unescaped the same way a quoting file is (the markdown
    `\\"` escape undone, curly quotes straightened) so a row and its quotation compare alike; strings
    shorter than one anchor are not bindable."""
    out: list[str] = []
    lines = guarantees.splitlines()
    for i, line in enumerate(lines):
        if not any(line.startswith(h) for h in _CANON_SECTIONS):
            continue
        j = i + 1
        while j < len(lines) and not lines[j].startswith("### "):
            j += 1
        out.extend(_squash_ws(m.group(1)).replace('\\"', '"').replace("\u201c", '"').replace("\u201d", '"')
                   for m in _CANON_BOLD_RE.finditer("\n".join(lines[i:j])))
    return [s for s in out if len(s.split()) >= _ANCHOR_WORDS]


def doc30_spec_restatement_fidelity(ctx: Ctx) -> list[Finding]:
    """Check 30: every quotation of a §2.8.2/§2.9.1 canonical string in a docs/spec/** file or the SSOT (a `"…"` span
    carrying any five consecutive tokens of it — or, for a string of nine tokens or fewer, one token off;
    tokens are case-folded, punctuation-stripped words) must be verbatim (squashed, `\\"` unescaped). An
    empty or missing catalog is a finding."""
    out: list[Finding] = []
    source = "docs/spec/02-guarantees.md"
    canon = _canonical_strings(ctx.docs.get(source, ""))
    if not canon:
        return _target_missing("30:spec-restatement-fidelity", source,
                               f"the §2.8.2/§2.9.1 canonical-string catalog in {source}")
    for rel, text in sorted(ctx.docs.items()):
        # The SSOT is in scope: it OUTRANKS the spec, so a drifted quotation there is the worse home (the round-15
        # finding); docs/plan quotes are history (blockquote-wrapped, partial) - out of scope, a named residual.
        if rel == source or not (rel.startswith("docs/spec/") or rel == "docs/SINGLE-SOURCE-OF-TRUTH.md"):
            continue
        # Curly quotes (U+201C/U+201D) are normalised to the straight mark first, so a curly-quoted quotation
        # is judged like a straight one (the round-5 G1 residual, closed rather than named).
        body = _squash_ws(text).replace('\\"', '"').replace("\u201c", '"').replace("\u201d", '"')
        # Every string quoted VERBATIM — the exact string between two quote marks — is blanked out of the body
        # BEFORE the spans are cut, so a correct quotation leaves no span whatever its inner shape (a
        # `"{name}"` fragment would otherwise split it into two spans that a blanking of the span text can
        # never match — the round-2 G1 finding), while authored text inside the same marks is NOT verbatim
        # and stays visible (a body-wide blanking hid it — the round-3 G1 finding). Canonical strings can
        # SHARE a run (the CleanupResidue and residue-annotation lines end alike), so a run found only inside
        # another string that IS quoted verbatim vanishes with it. What remains is searched for EVERY string,
        # the blanked ones included — a file that quotes a string correctly once and drifts in a second
        # quotation is still a drift (one string, one home, every quotation verbatim).
        reduced = body
        for s in sorted(canon, key=len, reverse=True):
            quoted_s = '"' + s + '"'
            if quoted_s in reduced:
                reduced = reduced.replace(quoted_s, '" "')
        spans = [" ".join(_tokens(m.group(1))) for m in _QUOTE_SPAN_RE.finditer(reduced)
                 if len(m.group(1)) <= _SPAN_MAX]
        spans = [st for st in spans if st]
        if not spans:
            continue
        for s in canon:
            short = len(_tokens(s)) <= _SHORT_WORDS
            if not _restates(spans, s) and not (short and any(_short_drift(st, s) for st in spans)):
                continue
            out.append(Finding("30:spec-restatement-fidelity", rel, 0,
                               "quotes a §2.8.2/§2.9.1 canonical string but NOT verbatim - the catalog "
                               f"row reads: \"{s}\" (one string, one home: quote it exactly, or paraphrase "
                               "without a five-word run of it)"))
    return out

# --- check 32: the SAST pin is single-sourced (the 2026-09-24 semgrep-bump class) ------------------------------
# requirements-ci.txt pins the Semgrep binary (`semgrep==X`, --require-hashes); its own header line, the
# build-gates G29 row and the P0.4.2 delivered note restate the current pin in prose. More than once
# (dfda4fb, d6847d0, the 2026-09-24 re-land of Dependabot #33) the bump carried the notes by hand, and a
# forgotten note is a stale version literal the doc graph cannot see (G68 resolves links, not numbers). This
# check reads the pin and requires each restating site to name it backticked, so a bump that leaves a note
# stale reds at L1 (CLAUDE.md §5: a version pin moves with every doc that restates it; DoD item 2).
_SAST_PIN_RE = re.compile(r"(?m)^semgrep==([0-9][\w.+-]*)")
_SAST_PIN_SITES = (
    ("requirements-ci.txt", r"(?m)^# Pinned EXACT-version .*$", "the requirements-ci.txt header line"),
    ("docs/security/build-gates.md", r"(?m)^\| \*\*G29\*\* \|.*$", "the build-gates G29 row"),
    ("docs/plan/P0-build-and-security.md", r"(?ms)^- \[.\] \*\*P0\.4\.2\*\*.*?(?=^- \[)", "the P0.4.2 delivered note"),
)


def _doc_text(ctx: Ctx, rel: str) -> str:
    text = ctx.docs.get(rel)
    if text is None:
        p = ctx.root / rel
        text = p.read_text(encoding="utf-8", errors="replace") if p.is_file() else ""
    return text


def doc32_sast_pin_sync(ctx: Ctx) -> list[Finding]:
    """Check 32: the `semgrep==` pin in requirements-ci.txt is named (backticked, or as `semgrep==X`) in the
    file's own header line, in the build-gates G29 row and in the P0.4.2 delivered note - the restating sites
    move with the pin, never after it. A missing requirements-ci.txt, and a requirements file without the
    pin, are each a finding."""
    req = ctx.root / "requirements-ci.txt"
    if not req.is_file():
        return _target_missing("32:sast-pin-sync", "requirements-ci.txt")
    m = _SAST_PIN_RE.search(req.read_text(encoding="utf-8", errors="replace"))
    if m is None:
        return [Finding("32:sast-pin-sync", "requirements-ci.txt", 0,
                        "no `semgrep==<version>` pin - the SAST binary pin is this file's reason to exist (G29)")]
    pin = m.group(1)
    out: list[Finding] = []
    for rel, site_re, label in _SAST_PIN_SITES:
        site = re.search(site_re, _doc_text(ctx, rel))
        if site is None or (f"`{pin}`" not in site.group(0) and f"semgrep=={pin}" not in site.group(0)):
            out.append(Finding("32:sast-pin-sync", rel, 0,
                               f"the current Semgrep pin `{pin}` (requirements-ci.txt) is not named in {label} - "
                               "a version pin moves with every doc that restates it (CLAUDE.md §5, DoD item 2)"))
    return out


# --- check 33: a gate-catalogue row never defers a leg to an unowned box (the G17 JS-leg class) ----------------
# build-gates G17 promised its `osv-scanner`-over-`pnpm-lock.yaml` leg as "later boxes" from P0.4.1 on; no box
# owned it, the phase audits read spec sentences and code comments (test-strategy §11.4 (e)), not the catalogue,
# and the JS graph ran unscanned for four phases. The SHAPE: a deferral adjective - later, future, subsequent,
# next, follow-on, follow-up, later-phase, own, separate, dedicated, owning, acquisition, staging, stage-slot -
# optionally wrapped in markdown emphasis, before the noun `box`/`boxes` or `phase`/`phases` (so "in later
# phases", "a **later** box", "its own acquisition box", "the Lane-B staging box" all read as a deferral; a
# hyphenated `box-id` does not), in docs/security/build-gates.md. Such a phrase must be owned: a box id
# (`P<n>.<m>`) that resolves to a real plan box within a few WORDS of it (4 before / 10 after - punctuation-only
# tokens do not count - inside the same sentence), not merely somewhere on the same line or in a comma-joined
# neighbour clause. Hard-wrapped paragraphs (§6 items, notes) are joined before the sentence split so a wrap
# cannot hide the phrase from its owner (test-strategy §11.4 (g)). The adjective list is the declared vocabulary
# of deferral in this catalogue; growing it is a one-line edit with a leg (the 2026-09-24 sweep found G17, G56,
# G37 and G19 with it).
# Scope: the catalogue's gate ROWS (`| **Gnn** |` table rows) and its §6 numbered check items - the places a leg
# is promised; generic process prose ("a follow-up box if structural") is not a promise and is not scanned.
# Named residuals: a deferral spelled WITHOUT a listed adjective ("the Lane-B box that wires staging", "the
# release box", "a P10 box") passes - the vocabulary is enumerated, not inferred, and grows by an adjective plus a
# leg here (a number word between the adjective and the noun, "the next two boxes", is the same gap; emphasis,
# backticks and parentheses around the adjective or the noun are tolerated - up to three markers before the
# adjective, after it and before the noun, so bold-italic passes too; after the noun only an underscore run of
# up to three is consumed before the word-boundary lookahead, because `_` is the one marker that is a word
# character (`_box_` / `___box___` would slip otherwise) while `*`, the backtick and `)` are non-word and pass
# the lookahead unconsumed - the per-member mutation battery is what fixed that shape); ownership is by NAME
# only (any resolvable id inside the window owns the phrase, a parenthetical one included), not verified against
# the box's content; non-deferral prose that fits the shape ("each engine gets its own box") reds. Escape hatch:
# NONE by design - the remedy for a false positive is rewording (a row states facts, not a deferral), never a
# marker; the remedy for a vocabulary miss is a new adjective + leg.
_DEFERRAL_ADJECTIVES = ("later", "future", "subsequent", "next", "follow-on", "follow-up", "later-phase", "own",
                        "separate", "dedicated", "owning", "acquisition", "staging", "stage-slot")
_ROW_PROMISE_RE = re.compile(
    r"\b(?:(?:a|an|the|its)\s+)?(?:[*_`(]{0,3}(?:" + "|".join(_DEFERRAL_ADJECTIVES) + r")[*_`)]{0,3}\s+)+"
    r"(?:P\d+\s+)?[*_`(]{0,3}(?:box(?:es)?|phases?)_{0,3}(?![\w-])", re.IGNORECASE)
_BOX_ID_RE = re.compile(r"\bP\d+(?:\.\d+)+\b")
_SENTENCE_SPLIT_RE = re.compile(r"(?<=[.;])\s+")
_PROMISE_WINDOW = (4, 10)           # WORDS before / after the phrase that may carry its owner id
_WORD_RE = re.compile(r"[0-9A-Za-z]")


def _catalogue_paragraphs(text: str) -> list[tuple[int, str]]:
    """(pure) (first lineno, joined text) per paragraph: a table row is one paragraph; a hard-wrapped list
    item, numbered item or blockquote joins its continuation lines; a blank line ends a paragraph."""
    out: list[tuple[int, str]] = []
    cur: tuple[int, str] | None = None
    for lineno, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            if cur is not None:
                out.append(cur)
            cur = None
            continue
        starts_new = (cur is None or line.startswith("|") or line.lstrip().startswith(("- ", "* ", "#"))
                      or re.match(r"^\s*\d+\.\s", line) is not None
                      or (line.startswith(">") != cur[1].startswith(">"))
                      or (not line.startswith((" ", "\t", ">")) and not cur[1].startswith(">")))
        if starts_new:
            if cur is not None:
                out.append(cur)
            cur = (lineno, line.strip())
        else:
            cur = (cur[0], cur[1] + " " + line.lstrip("> ").strip())
    if cur is not None:
        out.append(cur)
    return out


def doc33_gate_row_promise(ctx: Ctx) -> list[Finding]:
    """Check 33: every deferral-to-a-box phrase in docs/security/build-gates.md is owned by a real plan box named
    within a few words of it, in the same sentence (module comment above). A missing catalogue is a finding."""
    rel = "docs/security/build-gates.md"
    text = _doc_text(ctx, rel)
    if not text:
        return _target_missing("33:gate-row-promise", rel)
    out: list[Finding] = []
    for lineno, para in _catalogue_paragraphs(text):
        if not (para.startswith("|") or re.match(r"^\d+\.\s", para)):
            continue
        if not _ROW_PROMISE_RE.search(para):
            continue
        for sentence in _SENTENCE_SPLIT_RE.split(para):
            for pm in _ROW_PROMISE_RE.finditer(sentence):
                before = [w for w in sentence[:pm.start()].split() if _WORD_RE.search(w)]
                after = [w for w in sentence[pm.end():].split() if _WORD_RE.search(w)]
                window = " ".join(before[-_PROMISE_WINDOW[0]:] + after[:_PROMISE_WINDOW[1]])
                if not any(i in ctx.by_id for i in _BOX_ID_RE.findall(window)):
                    out.append(Finding("33:gate-row-promise", rel, lineno,
                                       f"a gate row defers a leg to an unowned box ({pm.group(0)!r} in "
                                       f"{sentence.strip()[:80]!r}) - name the owning P<n>.<m> box within a few words "
                                       "of the phrase (test-strategy §11.4 (g); the G17 JS-leg class)"))
    return out


# --- check 31: the phase-boundary sweep binding (the 2026-09-09 scoped-STOP carve-out, made mechanical) ----------
# The `[!extern]` STOP is scoped to the blocked needs: closure (build-loop.md §3 step 1); the ONE carve-out is the
# standing phase-end Co-Pilot hardening-sweep box, which blocks its whole successor phase (test-strategy §11.3).
# That carve-out was a semantic classification carried in prose ("is THIS [!extern] the sweep box?"); this check
# binds it in plan data: one sweep box per phase >= 2, `[!extern]` until executed, the last box of its phase
# (every box after it - the final phase's RC sign-off - names it in needs:), and P<n+1>.1 names it in needs:.
_SWEEP_TITLE = "Run the phase-end Co-Pilot hardening sweep"


def doc31_sweep_binding(ctx: Ctx) -> list[Finding]:
    """Check 31: for every phase >= 2 with boxes, exactly one box titled with the standing sweep phrase, marked
    `[!extern]` (or `[x]` once executed), followed in document order only by boxes that `needs:` it, and named
    in `needs:` by the successor phase's first box P<n+1>.1 - so the phase-boundary stop follows from the plan,
    never from prose alone (test-strategy §11.3; build-loop.md §3 step 1)."""
    out: list[Finding] = []
    phases = sorted({b.phase for b in ctx.boxes if b.phase >= 2})
    terminal = max((b.phase for b in ctx.boxes), default=0)
    for n in phases:
        boxes_n = [b for b in ctx.boxes if b.phase == n]
        sweeps = [b for b in boxes_n if b.title.startswith(_SWEEP_TITLE)]
        if len(sweeps) != 1:
            out.append(Finding("31:sweep-binding", boxes_n[0].file, 0,
                               f"P{n}: {len(sweeps)} phase-end sweep boxes (exactly one expected, titled "
                               f"{_SWEEP_TITLE!r}... - test-strategy §11)"))
            continue
        sweep = sweeps[0]
        if sweep.marker not in ("!extern", "x"):
            out.append(Finding("31:sweep-binding", sweep.file, sweep.lineno,
                               f"{sweep.box_id}: the phase-end sweep box is [!extern] until executed (or [x]), "
                               f"found [{sweep.raw_marker}]"))
        for b in boxes_n:
            if b.file == sweep.file and b.lineno > sweep.lineno and sweep.box_id not in b.needs:
                out.append(Finding("31:sweep-binding", b.file, b.lineno,
                                   f"{b.box_id}: follows the phase-end sweep box {sweep.box_id} but does not "
                                   f"`needs:` it - the sweep is the phase's last work box (test-strategy §11)"))
        first = ctx.by_id.get(f"P{n + 1}.1")
        if first is None and n < terminal:
            out.append(Finding("31:sweep-binding", sweep.file, sweep.lineno,
                               f"P{n + 1}.1 is absent, so nothing carries `needs: {sweep.box_id}` - the "
                               f"phase-boundary stop needs the successor's first box (test-strategy §11.3)"))
        elif first is not None and sweep.box_id not in first.needs:
            out.append(Finding("31:sweep-binding", first.file, first.lineno,
                               f"{first.box_id}: must carry `needs: {sweep.box_id}` - the phase-boundary stop is "
                               f"this edge (test-strategy §11.3)"))
    return out


FORMAT_CHECKS = {
    "format:box-parse-completeness": fmt_box_parse_completeness,
