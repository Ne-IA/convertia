# Local scratch / throwaway working notes (deleted once folded into the spec)
temp.md

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
/src-tauri/target/
target/

# Coverage reports (generated each run by the P1.54 §6.7.1 coverage leg: vitest v8 -> coverage/,
# cargo-llvm-cov -> target/llvm-cov/ which target/ already covers). Machine-read by check-coverage
# (G27/G28) then discarded — never committed.
coverage/

# Tauri build-time generated schemas/context (regenerated by build.rs `tauri_build::build()`)
/src-tauri/gen/

# G53 negative-fixture lockfile: the g24-core-deps self-test runs `cargo metadata` on tests/g53-fixture/,
# which regenerates this lock each run (the live leg skips gracefully offline, so no pinned lock is needed).
# The fixture's tracked + L(-1)-caged Cargo.toml (the planted libvips-sys violation) is the source of truth.
/tests/g53-fixture/Cargo.lock

# Installed pinned gate tools (downloaded + checksum-verified by scripts/install-gate-tools)
.gate-tools/

# The restored engine-asset cache (§6.1.3, keyed `<engine>-<version>-<triple>`) that
# scripts/stage-engines reads, and the engine bytes it stages out of it. Both are build-time
# artifacts, never committed (DEVELOPMENT.md "Bundled conversion engines"); the tracked .gitkeep
# keeps the two §0.7/CLAUDE-§1a-mapped destination dirs present for G69.
.engine-cache/
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep
/src-tauri/resources/*
!/src-tauri/resources/.gitkeep

# Python bytecode cache (the stdlib-only gate + bootstrap scripts)
__pycache__/
*.pyc

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
